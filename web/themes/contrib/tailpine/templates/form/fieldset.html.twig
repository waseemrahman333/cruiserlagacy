{#
/**
 * @file
 * Theme override for a fieldset element and its children.
 *
 * Available variables:
 * - attributes: HTML attributes for the fieldset element.
 * - errors: (optional) Any errors for this fieldset element, may not be set.
 * - required: Boolean indicating whether the fieldset element is required.
 * - legend: The legend element containing the following properties:
 *   - title: Title of the fieldset, intended for use as the text of the legend.
 *   - attributes: HTML attributes to apply to the legend.
 * - description: The description element containing the following properties:
 *   - content: The description content of the fieldset.
 *   - attributes: HTML attributes to apply to the description container.
 * - children: The rendered child elements of the fieldset.
 * - prefix: The content to add before the fieldset children.
 * - suffix: The content to add after the fieldset children.
 *
 * @see template_preprocess_fieldset()
 */
#}
{#
  Rendered inline — not delegated to tailpine:fieldset SDC — to avoid
  JSON Schema recursion. legend.attributes and description.attributes are
  Attribute objects nested inside array props, which cannot be JSON-encoded
  by the SDC prop validator without hitting arrayToObjectRecursive() recursion.
#}
{%
  set classes = [
    'js-form-item',
    'form-item',
    'js-form-wrapper',
    'form-wrapper',
    'border',
    'border-border',
    'bg-surface',
    'p-4',
    'mb-4',
  ]
%}
{%
  set legend_classes = [
    'text-base',
    'font-semibold',
    'text-body',
    'px-2',
  ]
%}
{%
  set legend_span_classes = [
    'fieldset-legend',
    required ? 'js-form-required',
    required ? 'form-required',
  ]
%}
<fieldset{{ attributes.addClass(classes) }}>
  <legend{{ (legend.attributes|default(create_attribute())).addClass(legend_classes) }}>
    <span{{ (legend_span.attributes|default(create_attribute())).addClass(legend_span_classes) }}>{{ legend.title }}</span>
  </legend>
  <div class="fieldset-wrapper">
    {% if errors %}
      <div class="form-item--error-message text-sm text-error mt-2 font-medium">{{ errors }}</div>
    {% endif %}
    {% if prefix %}
      <span class="field-prefix">{{ prefix }}</span>
    {% endif %}
    {{ children }}
    {% if suffix %}
      <span class="field-suffix">{{ suffix }}</span>
    {% endif %}
    {% if description.content %}
      <div{{ (description.attributes|default(create_attribute())).addClass('description', 'text-sm', 'text-muted', 'mt-2') }}>{{ description.content }}</div>
    {% endif %}
  </div>
</fieldset>
