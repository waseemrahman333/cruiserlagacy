{#
/**
 * @file
 * Theme override for a details element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the details element.
 * - errors: (optional) Any errors for this details element, may not be set.
 * - title: (optional) The title of the element, may not be set.
 * - summary_attributes: A list of HTML attributes for the summary element.
 * - description: (optional) The description of the element, may not be set.
 *   May be a string or an array with 'content' and 'attributes' keys.
 * - children: (optional) The children of the element, may not be set.
 * - value: (optional) The value of the element, may not be set.
 *
 * @see template_preprocess_details()
 */
#}
{#
  Pass only declared props to the SDC. Extract description.content when
  description is an array (Drupal passes it as ['content' => ..., 'attributes'
  => Attribute] which causes JSON Schema recursion during prop validation).
#}
{%- include "tailpine:details" with {
  attributes: attributes,
  summary_attributes: summary_attributes,
  title: title,
  required: required,
  errors: errors,
  description: description.content|default(description)|default(''),
  children: children,
  value: value,
} only -%}
