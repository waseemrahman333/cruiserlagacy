

<header class="header-wrapper mx-auto w-full bg-body-bg {{ header_fixed_class }}">
  <div
    class="relative w-full flex items-center justify-between container py-4  text-body shadow-md"
    x-data="{ open: false, mobOpen: false, searchOpen: false }"
    @click.away="searchOpen = false"
    @keydown.escape="searchOpen = false"
  >
    <!-- Branding: always left -->
    <div class="header_branding flex-shrink-0">
      {{ page.branding }}
    </div>

    <!-- Right-side wrapper: Menu + Actions -->
    <div class="flex items-center gap-6 lg:gap-8">
      <!-- Desktop Menu (grouped right next to actions) -->
      <div class="hidden lg:!block">
        {{ page.header_menu }}
      </div>

      <div class="search-icon">
        {{ page.search }}
        </div>
      <!-- Mobile Menu (visible only on mobile) -->
      <div class="lg:hidden ">
        {{ page.header_menu }}
      </div>
           
    </div>
  </div>
  </header>