<header class="mx-auto w-full {{ header_fixed_class }} bg-body-bg">
  <div
    class="relative container w-full flex items-center justify-between  py-4  text-body shadow-md"
    x-data="{ open: false, mobOpen: false, searchOpen: false }"
    @click.away="searchOpen = false"
    @keydown.escape="searchOpen = false"
  >
    <!-- Branding: always left -->
    <div class="header_branding flex-shrink-0">
      {{ page.branding }}
    </div>

    <!-- Right-side wrapper: Menu + Actions -->
    <div class="flex items-center gap-6 lg:gap-8">
      <!-- Desktop Menu (grouped right next to actions) -->
      <div class="hidden lg:!block">
        {{ page.header_menu }}
      </div>

      <!-- Actions (e.g., Contact Us button) -->
      <div class="right-actions md:!block">
        {{ page.header_actions }}
      </div>
      <!-- Mobile Menu (visible only on mobile) -->
      <div class="lg:hidden ">
        {{ page.header_menu }}
      </div>
    </div>
</div>
  </header>
