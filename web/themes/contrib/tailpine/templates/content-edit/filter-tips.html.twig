{#
/**
 * @file
 * Theme override for a set of filter tips.
 *
 * Available variables:
 * - tips: Descriptions and a CSS ID for each filter in one or more text formats.
 * - long: TRUE if the passed-in filter tips contain extended explanations.
 * - multiple: TRUE if there is more than one filter tip.
 *
 * @see template_preprocess_filter_tips()
 */
#}

{% if multiple %}
  <h2 class="text-xl font-semibold text-heading mb-4">{{ 'Text Formats'|t }}</h2>
{% endif %}

{% if tips|length %}
  {% if multiple %}
    <div class="compose-tips space-y-6">
  {% endif %}

  {% for name, tip in tips %}
    {% if multiple %}
      {%
        set tip_classes = [
          'filter-type',
          'filter-' ~ name|clean_class,
          'border',
          'border-border',
          'bg-surface',
          'p-4',
        ]
      %}
      <div{{ tip.attributes.addClass(tip_classes) }}>
        <h3 class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">{{ tip.name }}</h3>
    {% endif %}

    {% if tip.list|length %}
      <ul class="tips text-sm text-muted list-disc pl-5 space-y-1">
        {% for item in tip.list %}
          {%
            set item_classes = [
              long ? 'filter-' ~ item.id|replace({'/': '-'}),
            ]
          %}
          <li{{ item.attributes.addClass(item_classes) }}>{{ item.tip }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if multiple %}
      </div>
    {% endif %}
  {% endfor %}

  {% if multiple %}
    </div>
  {% endif %}
{% endif %}
