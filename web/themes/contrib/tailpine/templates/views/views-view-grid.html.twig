{#
/**
 * @file
 * Theme override for views to display rows in a grid.
 *
 * @see template_preprocess_views_view_grid()
 */
#}
{%
  set classes = [
    'views-view-grid',
    options.alignment,
  ]
%}
{% if options.row_class_default %}
  {% set row_classes = ['views-row'] %}
{% endif %}
{% if options.col_class_default %}
  {% set col_classes = ['views-col'] %}
{% endif %}
{% if title %}
  <h3 class="text-lg font-semibold text-body mb-4">{{ title }}</h3>
{% endif %}
<div{{ attributes.addClass(classes).addClass([
  'grid',
  'gap-6',
  options.columns ? 'grid-cols-' ~ options.columns : 'grid-cols-3',
]) }}>
  {% if options.alignment == 'horizontal' %}
    {% for row in items %}
      {% for column in row.content %}
        <div{{ column.attributes.addClass(col_classes|default([])).addClass([
          'bg-body-bg',
          'border',
          'border-border',
          'overflow-hidden',
          'hover:shadow-md',
          'transition-shadow',
        ]) }}>
          {{- column.content -}}
        </div>
      {% endfor %}
    {% endfor %}
  {% else %}
    {% for column in items %}
      {% for row in column.content %}
        <div{{ row.attributes.addClass(row_classes|default([])).addClass([
          'bg-body-bg',
          'border',
          'border-border',
          'overflow-hidden',
          'hover:shadow-md',
          'transition-shadow',
        ]) }}>
          {{- row.content -}}
        </div>
      {% endfor %}
    {% endfor %}
  {% endif %}
</div>
