{#
/**
 * @file
 * Theme override for a main view template.
 *
 * @see template_preprocess_views_view()
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}
  {% if header %}
    <div class="view-header mb-4">
      {{ header }}
    </div>
  {% endif %}
  {% if exposed %}
    <div class="view-filters mb-6">
      {{ exposed }}
    </div>
  {% endif %}
  {% if attachment_before %}
    <div class="attachment attachment-before mb-4">
      {{ attachment_before }}
    </div>
  {% endif %}
  {% if rows %}
    <div class="view-content">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty py-8 text-center text-muted italic">
      {{ empty }}
    </div>
  {% endif %}
  {% if pager %}
    <div class="view-pager mt-6">
      {{ pager }}
    </div>
  {% endif %}
  {% if attachment_after %}
    <div class="attachment attachment-after mt-4">
      {{ attachment_after }}
    </div>
  {% endif %}
  {% if more %}
    <div class="view-more mt-4">
      {{ more }}
    </div>
  {% endif %}
  {% if footer %}
    <div class="view-footer mt-6 pt-4 border-t border-border">
      {{ footer }}
    </div>
  {% endif %}
  {% if feed_icons %}
    <div class="feed-icons mt-2">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
