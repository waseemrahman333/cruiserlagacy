{#
/**
 * @file
 * Theme override to display a node.
 *
 * @see \Drupal\node\Hook\NodeThemeHooks::preprocessNode()
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished bg-error/10',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}

<article{{ attributes.addClass(classes) }}>

  {{ title_prefix }}

  {% if label and view_mode != 'full' %}
    <h2{{ title_attributes.addClass('text-2xl font-bold mb-4 leading-snug') }}>
      <a href="{{ url }}" rel="bookmark" class="text-heading hover:text-primary transition-colors">
        {{ label }}
      </a>
    </h2>
  {% endif %}

  {{ title_suffix }}

  {% if display_submitted %}
    <footer class="node__meta flex items-center gap-3 text-sm text-muted mb-6 pb-4 border-b border-border">
      {% if author_picture %}
        <div class="w-8 h-8 overflow-hidden ring-1 ring-border flex-shrink-0 bg-surface-alt">
          {{ author_picture }}
        </div>
      {% endif %}
      <div{{ author_attributes.addClass('node__submitted') }}>
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
        {{ metadata }}
      </div>
    </footer>
  {% endif %}

  <div{{ content_attributes.addClass([
    'node__content',
    'prose',
    'max-w-none',
    view_mode == 'full' ? 'max-w-4xl',
  ]) }}>
    {{ content }}
  </div>

</article>
