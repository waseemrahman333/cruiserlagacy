{#
/**
 * @file
 * Theme override for a marker for new or updated content.
 *
 * Available variables:
 * - status: Number representing the marker status to display. Use the constants
 *   below for comparison:
 *   - MARK_NEW
 *   - MARK_UPDATED
 *   - MARK_READ
 */
#}
{% if logged_in %}
  {% if status is constant('MARK_NEW') %}
    <span class="marker bg-primary text-on-primary text-xs font-semibold px-1.5 py-0.5 ml-1 uppercase tracking-wide">{{ 'New'|t }}</span>
  {% elseif status is constant('MARK_UPDATED') %}
    <span class="marker bg-secondary text-on-primary text-xs font-semibold px-1.5 py-0.5 ml-1 uppercase tracking-wide">{{ 'Updated'|t }}</span>
  {% endif %}
{% endif %}
