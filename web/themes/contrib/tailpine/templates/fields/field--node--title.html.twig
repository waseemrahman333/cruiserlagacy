{#
/**
 * @file
 * Theme override for the node title field.
 *
 * Available variables:
 * - label: The field label.
 * - items: List of all the field items keyed by delta.
 * - attributes: HTML attributes for the wrapper.
 *
 * @see \Drupal\Core\Field\FieldPreprocess::preprocessField()
 */
#}
{% include "tailpine:title" with {
  label: label,
  items: items,
  attributes: attributes,
} only %}
