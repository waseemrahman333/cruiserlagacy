<?php

/**
 * @file
 * Preprocess logic for the page.html.twig template.
 */

use Drupal\tailpine\TailpineColors;
use Drupal\canvas\Entity\PageRegion;

/**
 * Implements hook_preprocess_page().
 */
function tailpine_preprocess_page(array &$variables): void {
  if (\Drupal::moduleHandler()->moduleExists('canvas')) {
    $theme = \Drupal::theme()->getActiveTheme()->getName();
    $page_regions = PageRegion::loadForTheme($theme);
    $variables['canvas_enabled'] = !empty($page_regions);
  }

  $header_style = theme_get_setting('header_class') ?: 'style4';
  $variables['header_template'] = 'header--' . $header_style;

  $variables['fixed'] = theme_get_setting('header_fixed');
  $variables['header_fixed_class'] = $variables['fixed'] ? 'fixed z-40 w-full' : '';

  $footer_style = theme_get_setting('footer_class') ?: 'style1';
  $variables['footer_template'] = 'footer--' . $footer_style;

  if (!isset($variables['logo'])) {
    $variables['logo'] = theme_get_setting('logo.url');
  }

  // Render the color theme switcher into the configured region.
  $variables['#attached']['library'][] = 'tailpine/color-theme-switcher';

  if (theme_get_setting('show_color_switcher') ?? FALSE) {
    $region = theme_get_setting('color_switcher_region') ?: 'secondary_menu';
    if (isset($variables['page'][$region]) && is_array($variables['page'][$region])) {
      $variables['page'][$region]['tailpine_color_switcher'] = [
        '#type' => 'component',
        '#component' => 'tailpine:color-switcher',
        '#props' => [
          'themes' => TailpineColors::getSwatchMap(),
          'current_theme' => theme_get_setting('color_theme') ?: 'cyberpunk',
          'show_labels' => FALSE,
        ],
        '#cache' => ['tags' => ['config:tailpine.settings']],
      ];
    }
  }
}

/**
 * Determines whether Canvas page regions are configured for Tailpine.
 *
 * @return bool
 *   TRUE if Canvas page regions exist, FALSE otherwise.
 */
function tailpine_canvas_enabled(): bool {
  if (!\Drupal::moduleHandler()->moduleExists('canvas')) {
    return FALSE;
  }

  $theme = \Drupal::theme()->getActiveTheme()->getName();
  $page_regions = PageRegion::loadForTheme($theme);

  return !empty($page_regions);
}
