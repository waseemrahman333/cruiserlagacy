/**
 * Generates CSS variables for Tailpine container, logo, and typography settings.
 *
 * @return string
 *   Generated CSS variables.
 */
function tailpine_get_container_variables(): string {

  // Responsive viewport breakpoints.
  $viewports = [390, 768, 1280, 1920];

  // Container padding values.
  $container_padding = [
    390 => (float) (theme_get_setting('container_padding_mobile') ?: 20),
    768 => (float) (theme_get_setting('container_padding_tablet') ?: 60),
    1280 => (float) (theme_get_setting('container_padding_desktop') ?: 96),
    1920 => (float) (theme_get_setting('container_padding_wide') ?: 120),
  ];

  // Responsive logo sizes.
  $customize_logo_size = theme_get_setting('tailpine_customize_logo_size');

  $logo_sizes = [];

  if ($customize_logo_size) {
    $logo_sizes = [
      390 => (int) (theme_get_setting('responsive_logo_mobile') ?: 73),
      768 => (int) (theme_get_setting('responsive_logo_tablet') ?: 80),
      1280 => (int) (theme_get_setting('responsive_logo_desktop') ?: 100),
    ];
  }

  // Responsive heading size defaults.
  $heading_defaults = [
    'h1' => [
      'mobile' => 36,
      'tablet' => 56,
      'desktop' => 80,
      'wide_desktop' => 112,
    ],
    'h2' => [
      'mobile' => 30,
      'tablet' => 40,
      'desktop' => 56,
      'wide_desktop' => 72,
    ],
    'h3' => [
      'mobile' => 26,
      'tablet' => 32,
      'desktop' => 40,
      'wide_desktop' => 48,
    ],
    'h4' => [
      'mobile' => 22,
      'tablet' => 26,
      'desktop' => 32,
      'wide_desktop' => 36,
    ],
    'h5' => [
      'mobile' => 20,
      'tablet' => 22,
      'desktop' => 24,
      'wide_desktop' => 28,
    ],
    'h6' => [
      'mobile' => 18,
      'tablet' => 20,
      'desktop' => 20,
      'wide_desktop' => 24,
    ],
  ];

  $breakpoint_names = [
    'mobile',
    'tablet',
    'desktop',
    'wide_desktop',
  ];

  // Calculate fluid container padding values.
  $container_sizes = array_values($container_padding);

  $container_values = [
    tailpine_fluid_value(
      $container_sizes[0],
      $container_sizes[1],
      $viewports[0],
      $viewports[1]
    ),
    tailpine_fluid_value(
      $container_sizes[1],
      $container_sizes[2],
      $viewports[1],
      $viewports[2]
    ),
    tailpine_fluid_value(
      $container_sizes[2],
      $container_sizes[3],
      $viewports[2],
      $viewports[3]
    ),
    $container_sizes[3] . 'px',
  ];

  // Collect CSS variable values for every heading.
  $heading_values = [];

  foreach ($heading_defaults as $heading => $defaults) {
    $sizes = [];

    foreach ($breakpoint_names as $index => $breakpoint) {
      $setting_name = $heading . '_' . $breakpoint;
      $saved_value = theme_get_setting($setting_name);

      $sizes[] = (float) (
        $saved_value !== NULL && $saved_value !== ''
          ? $saved_value
          : $defaults[$breakpoint]
      );
    }

    $heading_values[$heading] = [
      tailpine_fluid_value(
        $sizes[0],
        $sizes[1],
        $viewports[0],
        $viewports[1]
      ),
      tailpine_fluid_value(
        $sizes[1],
        $sizes[2],
        $viewports[1],
        $viewports[2]
      ),
      tailpine_fluid_value(
        $sizes[2],
        $sizes[3],
        $viewports[2],
        $viewports[3]
      ),
      $sizes[3] . 'px',
    ];
  }

  // Assemble all variables into one root block per breakpoint.
  $variables = [];

  foreach ($viewports as $index => $viewport) {
    $declarations = [];

    // Container padding.
    $declarations[] = '--t-container-padding-inline: '
      . $container_values[$index] . ';';

    // Logo width, when customization is enabled.
    if (isset($logo_sizes[$viewport])) {
      $declarations[] = '--t-logo-width: '
        . $logo_sizes[$viewport] . 'px;';
    }

    // Heading typography.
    foreach ($heading_values as $heading => $values) {
      $declarations[] = '--' . $heading . '-size: '
        . $values[$index] . ';';
    }

    $root = ":root {\n  " . implode("\n  ", $declarations) . "\n}";

    if ($index === 0) {
      // Base styles for mobile.
      $variables[] = $root;
    }
    else {
      // Responsive styles for tablet, desktop, and wide desktop.
      $variables[] = "@media (min-width: {$viewport}px) {\n  "
        . str_replace("\n", "\n  ", $root)
        . "\n}";
    }
  }

  return implode("\n\n", $variables);
}


// ------------------------

/**
 * Returns the custom color theme CSS variables.
 *
 * @return string
 *   The generated custom color CSS variables.
 */
function tailpine_get_color_variables(): string {
  if (!theme_get_setting('tailpine_enable_color') || theme_get_setting('color_theme') !== 'custom') {
    return '';
  }

  $css_lines = [];

  foreach (TailpineColors::VARIABLES as $var_name => $meta) {
    $setting_key = TailpineColors::getSettingKey($var_name);
    $value = theme_get_setting($setting_key);

    if ($value) {
      $sanitized = TailpineColors::sanitizeColorValue($value);

      if ($sanitized !== '') {
        $css_var = TailpineColors::getCssVarName($var_name);
        $css_lines[] = "$css_var: $sanitized;";
      }
    }
  }

  if (empty($css_lines)) {
    return '';
  }

  return 'html[data-theme="custom"] {' . "\n"
    . '  ' . implode("\n  ", $css_lines) . "\n"
    . "}\n";
}

/**
 * Generates the Tailpine runtime CSS variables file.
 *
 * @return string|null
 *   The generated file path, or NULL if generation failed.
 */
function tailpine_generate_variables_css(): ?string {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('tailpine');

  $directory = DRUPAL_ROOT . '/' . $theme_path . '/css';
  $file_path = $directory . '/theme-variables.css';

  $file_system = \Drupal::service('file_system');

  // Create the directory if it does not exist.
  if (!$file_system->prepareDirectory(
    $directory,
    FileSystemInterface::CREATE_DIRECTORY
    | FileSystemInterface::MODIFY_PERMISSIONS
  )) {
    return NULL;
  }

  $css = "/*
 * Tailpine Runtime Design Variables.
 *
 * This file is generated automatically from Tailpine theme settings.
 * Do not edit this file manually.
 */

";

  // Add container variables.
  $css .= tailpine_get_container_variables();

  $css .= "\n";

  // Add custom color variables.
  $css .= tailpine_get_color_variables();

  $css .= "\n";

  try {
    $file_system->saveData(
      $css,
      $file_path,
      FileSystemInterface::EXISTS_REPLACE
    );
  }
  catch (\Exception $e) {
    \Drupal::logger('tailpine')->error(
      'Unable to generate Tailpine variables CSS: @message',
      [
        '@message' => $e->getMessage(),
      ]
    );

    return NULL;
  }

  return $file_path;
}

/**
 * Returns the Tailpine runtime variables CSS URI.
 *
 * The CSS file is regenerated from the current theme settings.
 *
 * @return string|null
 *   The generated file URI.
 */
function tailpine_get_variables_css_uri(): ?string {
  return tailpine_generate_variables_css();
}
