<?php

/**
 * @file
 * Preprocess.misc.theme.
 *
 * Miscellaneous preprocess hooks that don't warrant their own file.
 */

use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\Render\Element\StatusMessages;
use Drupal\tailpine\TailpineColors;

/**
 * Implements hook_preprocess().
 */
function tailpine_preprocess(array &$variables, string $hook): void {
  $variables['container_type'] = theme_get_setting('container_style') ?: 'full';
}

/**
 * Implements hook_preprocess_image_widget().
 */
function tailpine_preprocess_image_widget(array &$variables): void {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container
  // HTML to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

/**
 * Implements hook_preprocess_input().
 *
 * Adds the input type variable to input templates.
 */
function tailpine_preprocess_input(array &$variables): void {
  $variables['type'] = $variables['element']['#type'] ?? '';
}

/**
 * Implements hook_preprocess_block__system_messages_block().
 */
function tailpine_preprocess_block__system_messages_block(array &$variables): void {
  $variables['content'] = StatusMessages::renderMessages();
}

/**
 * Implements hook_preprocess_paragraph__TYPE() for tailpine_slider.
 */
function tailpine_preprocess_paragraph__tailpine_slider(array &$variables): void {
  $variables['#attached']['library'][] = 'tailpine/swiper';
  $variables['#attached']['library'][] = 'tailpine/swiper-custom';
}

/**
 * Generates a fluid CSS clamp value between two viewport points.
 *
 * @param float $min_size
 *   Font size at the minimum viewport.
 * @param float $max_size
 *   Font size at the maximum viewport.
 * @param float $min_viewport
 *   Minimum viewport width.
 * @param float $max_viewport
 *   Maximum viewport width.
 *
 * @return string
 *   CSS clamp() value.
 */
function tailpine_fluid_value(
  float $min_size,
  float $max_size,
  float $min_viewport,
  float $max_viewport,
): string {
  if ($max_viewport <= $min_viewport) {
    return "{$min_size}px";
  }

  $slope = ($max_size - $min_size)
    / ($max_viewport - $min_viewport);

  $vw = $slope * 100;

  $intercept = $min_size - ($slope * $min_viewport);

  return sprintf(
    'clamp(%spx, calc(%svw + %spx), %spx)',
    $min_size,
    round($vw, 4),
    round($intercept, 4),
    $max_size
  );
}

