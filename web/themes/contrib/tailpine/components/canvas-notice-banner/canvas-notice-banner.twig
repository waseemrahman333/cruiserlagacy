{#
/**
 * Notice Banner (Canvas)
 *
 * Alert-style banner with icon, dismiss button, and optional action.
 *
 * Variables:
 * - type: 'info'|'success'|'warning'|'danger'
 * - dismissible: bool
 * - show_icon: bool
 * - show_action: bool
 * - sticky: bool
 * - message: rich-text HTML string
 * - action_label: string
 *
 * Accessibility:
 * - role="alert" on the root element.
 * - Dismiss button has aria-label.
 * - Icons are aria-hidden.
 *
 * Theme tokens used:
 * - bg-primary/10, bg-secondary/10, bg-tertiary/10, bg-dark/10 — tinted backgrounds
 * - border-primary/30, border-secondary/30, border-tertiary/30, border-dark/30 — borders
 * - text-body — body text
 * - text-primary, text-secondary, text-tertiary, text-heading — icon colors
 * - focus:ring-focus — focus rings
 */
#}
{% set safe_type = type|default('info')|striptags %}

{% set type_map = {
  'info':    'bg-primary/10 border border-primary/30 text-body',
  'success': 'bg-secondary/10 border border-secondary/30 text-body',
  'warning': 'bg-tertiary/10 border border-tertiary/30 text-body',
  'danger':  'bg-dark/10 border border-dark/30 text-body',
} %}
{% set type_class = type_map[safe_type]|default('bg-primary/10 border border-primary/30 text-body') %}

{% set sticky_class = sticky ? 'sticky top-0 z-50' : '' %}

<div
  class="canvas-notice-banner canvas-notice-banner--{{ safe_type }} w-full px-4 py-3 {{ type_class }} {{ sticky_class }}"
  role="alert"
  {{ attributes }}
  x-data="{ dismissed: false }"
  x-show="!dismissed"
  x-transition
>
  <div class="flex items-start gap-3 max-w-[1920px] mx-auto">

    {% if show_icon %}
      <span class="canvas-notice-banner__icon flex-shrink-0 mt-0.5" aria-hidden="true">
        {% if safe_type == 'info' %}
          <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
        {% elseif safe_type == 'success' %}
          <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        {% elseif safe_type == 'warning' %}
          <svg class="w-5 h-5 text-tertiary" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
        {% else %}
          <svg class="w-5 h-5 text-heading" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
        {% endif %}
      </span>
    {% endif %}

    <div class="canvas-notice-banner__body flex-1 text-sm">
      {% if message %}{{ message|raw }}{% endif %}
    </div>

    {% if show_action and action_label %}
      <button type="button" class="canvas-notice-banner__action flex-shrink-0 text-sm font-medium underline hover:no-underline focus:outline-none focus:ring-2 focus:ring-focus rounded">
        {{ action_label|striptags }}
      </button>
    {% endif %}

    {% if dismissible %}
      <button
        type="button"
        class="canvas-notice-banner__dismiss flex-shrink-0 ml-auto p-1 rounded hover:bg-dark/10 focus:outline-none focus:ring-2 focus:ring-focus"
        x-on:click="dismissed = true"
        aria-label="{{ 'Dismiss'|t }}"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
      </button>
    {% endif %}

  </div>
</div>
