{# ---------------------------------------------------------------------------
 # Accordion Style 2 – Header + Items Wrapper
 # --------------------------------------------------------------------------- #}

{% set wrapper_attributes = attributes|default(create_attribute()) %}

<!-- Accordion Style 2 Header -->
<div
  {{ wrapper_attributes.addClass(
    'max-w-[1920px] w-full mx-auto grid grid-cols-1 lg:grid-cols-2 items-start gap-6 md:gap-8 lg:gap-12
     py-15 px-5 md:py-[92px] md:px-[50px] lg:py-[104px] lg:px-25'
  ) }}
>
  <div class="md:max-w-[800px] lg:max-w-3xl xl:pr-20">
    {% if title %}
      <h2 class="text-3xl md:text-4xl lg:text-[46px] font-medium mb-2 lg:mb-6 text-body">
        {% block title %}
          {{ title }}
        {% endblock %}
      </h2>
    {% endif %}

      {% if text %}
        {% set description_text %}
          {% block text %}

          {% endblock %}
        {% endset %}
        {% if description_text|trim  %}
        <div class="h-fit py-2">
            {{ description_text|trim  }}
            </div>
        {% endif %}
      {% endif %}
  </div>

  {% if content %}
    <div class="space-y-2.5">
      {% block content %}
        {{ content }}
      {% endblock %}
    </div>
  {% endif %}
</div>
