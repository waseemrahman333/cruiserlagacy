{% set is_open = default_open|default(false) %}

<div 
  class="w-full max-w-3xl mx-auto space-y-3"
  x-data="{ activeIndex: {{ is_open ? 0 : 'null' }} }"
>

  <!-- Accordion Item -->
  <div class="overflow-hidden transition-all duration-500 ease-in-out">

    <button
      @click="activeIndex = activeIndex === 0 ? null : 0"
      class="w-full flex justify-between items-center border border-border text-left bg-surface px-5 py-4 font-semibold text-body hover:bg-surface-alt transition"
    >
      <span>{{ title }}</span>

      <span
        class="text-2xl font-bold text-body transition-transform duration-300"
        x-text="activeIndex === 0 ? '–' : '+'"
      ></span>

    </button>

    <div
      x-ref="panel0"
      x-bind:style="activeIndex === 0 ? 'max-height:' + $refs.panel0.scrollHeight + 'px; opacity:1;' : 'max-height:0; opacity:0;'"
      class="overflow-hidden transition-all duration-700 ease-in-out"
    >
      <div class="px-5 py-5 text-body text-sm leading-relaxed">
        {{ description }}
      </div>
    </div>

  </div>

</div>
