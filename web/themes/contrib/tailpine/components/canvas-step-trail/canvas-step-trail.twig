{#
/**
 * Step Trail (Canvas) — parent
 *
 * Variables: orientation, style, show_descriptions, current_step
 * Slots: items
 *
 * Theme tokens: bg-primary, text-on-primary, border-border, text-heading, text-muted
 */
#}
{% set safe_orientation = orientation|default('vertical')|striptags %}
{% set safe_style       = style|default('numbered')|striptags %}

<div
  class="canvas-step-trail canvas-step-trail--{{ safe_orientation }} canvas-step-trail--{{ safe_style }} w-full max-w-[1920px] mx-auto px-5 md:px-12 xl:px-24 py-16"
  data-current-step="{{ current_step|default(1) }}"
  data-show-descriptions="{{ show_descriptions|default(true) ? '1' : '0' }}"
  data-marker-style="{{ safe_style }}"
  {{ attributes }}
>
  <div class="canvas-step-trail__items {{ safe_orientation == 'horizontal' ? 'flex flex-row flex-wrap gap-8 md:gap-0' : 'flex flex-col' }}">
    {% block items %}
      {# Placeholder steps for Canvas editor preview #}
      {% for i in 1..3 %}
        <div class="canvas-step-trailitem relative flex gap-4 pb-10">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-sm font-bold">{{ i }}</div>
            {% if i < 3 %}<div class="absolute left-4 top-9 bottom-0 w-px bg-border"></div>{% endif %}
          </div>
          <div class="pt-1">
            <div class="text-heading font-semibold">{{ 'Step %num'|t({'%num': i}) }}</div>
            <div class="text-muted text-sm mt-1">{{ 'Step description goes here.'|t }}</div>
          </div>
        </div>
      {% endfor %}
    {% endblock %}
  </div>
</div>
