{# ---------------------------------------------------------------------------
 # Hero Background Component
 # --------------------------------------------------------------------------- #}

{% set color_classes = {
  'primary': 'text-primary',
  'secondary': 'text-secondary',
  'tertiary': 'text-tertiary',
  'white': 'text-body-bg',
  'light gray': 'text-muted',
  'dark gray': 'text-body',
  'black': 'text-dark',
  'transparent': 'text-transparent',
} %}

{% set bg_image = image_url.src|default('') %}
{% set color = text_color|default('default') %}
{% set title_color = color_classes[color]|default('text-body-bg') %}
{% set description_color = color_classes[description_text_color]|default('text-body-bg') %}


<section
	class="w-full bg-center bg-cover" aria-label="Hero background" {% if bg_image %} style="
		      background-image:
		        linear-gradient(0deg, rgba(10,15,20,0.6), rgba(10,15,20,0.6)),
		        linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 75%),
		        url('{{ bg_image }}');
		    " {% endif %}>
	<!-- Main Content -->
	<main class="
			      container
			      max-w-480
			      mx-auto
			      w-full
			      pt-[clamp(327px,25vw,478px)]
			      pb-[clamp(5rem,12vw,180px)]
			      flex
			      flex-col
			      gap-8
			      font-archivo
			    ">
		<div class="flex flex-col gap-5 text-body-bg">

			{% if title %}
				<h1 class=" {{ title_color }} font-bold text-[clamp(2.5rem,6vw,5rem)]
						                 leading-tight tracking-tighter
						                 xl:max-w-[900px]">
					{{ title }}
				</h1>
			{% endif %}

			{% if description %}
				<div class=" {{ description_color }} text-base font-normal md:text-xl
						                 md:max-w-[624px]
						                 tracking-[2%]">
					{{ description }}
				</div>
			{% endif %}

		</div>

		{% if cta %}
			<div class="flex gap-5 flex-col md:flex-row">
				{{ cta }}
			</div>
		{% endif %}
	</main>
</section>
