<section {{ attributes.addClass(
  'wrapper',
  'sm:py-12.5',
  'p-[clamp(20px,5vw,100px)]',
  'max-w-480',
  'mx-auto',
  'flex',
  'flex-col',
  'gap-10'
) }}>
  {# Static map — full class strings required for Tailwind JIT scanning. #}
  {% set position_map = {
    'row': 'lg:flex-row',
    'row-reverse': 'lg:flex-row-reverse',
    'col': 'lg:flex-col',
    'col-reverse': 'lg:flex-col-reverse',
  } %}
  {% set lg_flex_class = position_map[position|default('row')]|default('lg:flex-row') %}
  <div class="flex flex-col {{ lg_flex_class }} gap-[clamp(30px,5vw,40px)]">
    
    {# Image Column #}
    {% if image %}
      <div class="lg:w-1/2">
        <img
          class="object-cover h-full w-full"
          src="{{ image.src }}"
          alt="{{ image.alt }}"
          loading="lazy"
        />
      </div>
    {% endif %}

    {# Content Column #}
    <div class="info_container flex flex-col pt-5 gap-8 lg:w-1/2">
      
      <div class="info w-full flex flex-col lg:pr-8 gap-[clamp(18px,2vw,24px)]">
        {% if title %}
          <h2 class="text-[clamp(30px,2vw+1rem,46px)] font-medium leading-tight">
            {{ title }}
          </h2>
        {% endif %}

        {% if description %}
          <div class="text-body/70 font-normal leading-8">
            {{ description }}
          </div>
        {% endif %}
      </div>

      {% if cta %}
        <div class="flex gap-5">
          {{ cta }}
        </div>
      {% endif %}
    </div>

  </div>
</section>