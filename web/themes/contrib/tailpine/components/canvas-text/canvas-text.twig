{# ===============================
   Defaults / Mappings
================================ #}

{% set text_bg_color_class = color_variants[text_bg_color] %}

{% set text_width_class = title_width_map[text_width] %}

{# ===============================
   Build Final Classes
================================ #}


{% set text = text_content|striptags %}
{% set tag = html_tag|default('div') %}
{% set H_alignment = horizontal_align|default('left') %}
{% set V_alignment = vertical_align|default('left') %}
{% set size = text_size|default('responsive-base') %}
{% set color = text_color %}
{% set link_url = url|default(null) %}
{% set safe_decoration = text_decoration|default('default')|striptags %}

{% set resolved_decoration = (safe_decoration != 'default') ? safe_decoration : '' %}


{# set the spacing_classes padding and margins #}
{% set spacing_classes = [
  margin_variants[margin_bottom].bottom ?? '',
  margin_variants[margin_top].top ?? '',
  padding_variants[padding_block].block ?? '',
  padding_variants[padding_inline].inline ?? '',
]|filter(v => v)|join(' ') %}


{% set classes = [
  'h-fit',
  text_width_class,
  size_classes[size] ?? '',
  tag == 'a' ? 'transition duration-300 hover:opacity-80 hover:-translate-y-0.5' : '',
  color_variants[color].text|default(''),
  color_variants[text_bg_color].bg|default(''),
  spacing_classes,
  alignment_variants[H_alignment].text,
  resolved_decoration,
]|join(' ') %}


{% if text_classes is defined %}
  {% set classes = classes ~ ' ' ~ (text_classes is iterable ? text_classes|join(' ') : text_classes) %}
{% endif %}

{# ===============================
   Render
================================ #}

    {% if tag == 'a' %}
          <a 
            href="{{ url|default('#') }}"
            class="{{ classes|trim }}"
          >
            {{ text }}
          </a>
        {% else %}
          <{{ tag }} class="{{ classes|trim }}">
            {{ text }}
          </{{ tag }}>
    {% endif %}

