<li{{ attributes|default(create_attribute()) }}>
  {% if link.type == 'link' %}
    <a href="{{ link.url }}"
       class="inline-block bg-primary text-body-bg hover:opacity-80 transition-colors duration-200 ease-in-out px-4 py-2 text-sm font-medium"
       {% if link.options.attributes %}{{ create_attribute(link.options.attributes) }}{% endif %}>
      {{ link.title }}
    </a>
  {% else %}
    <span class="inline-block bg-primary text-body-bg px-4 py-2 text-sm font-medium">{{ link }}</span>
  {% endif %}
</li>
