{% set username = display_name ?? (items|first ? items|first.title|striptags : 'Account') %}
{% set username = username|first|upper ~ username|slice(1) %}

<div{{ attributes.addClass('relative') }}
  x-data="{ open: false }"
  x-on:keydown.escape.window="open = false"
>

  {% if logged_in %}

    {# ── Trigger (logged in) ── #}
    <button
      type="button"
      x-on:click="open = !open"
      x-on:mouseenter="open = true"
      x-bind:aria-expanded="open"
      aria-haspopup="true"
      class="flex items-center gap-2 rounded-full border border-transparent px-3 py-1.5 text-sm font-semibold text-body transition-all duration-150 focus-visible:ring-2 "
    >

      {# Trigger avatar #}
{% if use_avatar_image and picture %}
  <img src="{{ picture }}" alt="{{ username }}" class="h-6 w-6 shrink-0 rounded-full object-cover text-body"> <span class="text-sm text-body  hidden md:!block"> {{username}} </span>
{% else %}
  <span class="flex h-6 w-6 bg-primary shrink-0 items-center justify-center rounded-full text-body font-bold uppercase tracking-wide">
    {{ username|first|upper }} 
  </span> <span class="text-sm text-body"> {{username}} </span>
{% endif %}
      <svg
        class="h-3 w-3 shrink-0 text-body transition-transform duration-150"
        x-bind:class="open ? 'rotate-180' : ''"
        viewBox="0 0 12 12" fill="none" aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    {# ── Dropdown panel (logged in) ── #}
    <div
      x-show="open"
      x-on:mouseleave="open = false"
      x-on:click.outside="open = false"
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
      x-transition:enter-end="opacity-100 scale-100 translate-y-0"
      x-transition:leave="transition ease-in duration-100"
      x-transition:leave-start="opacity-100 scale-100 translate-y-0"
      x-transition:leave-end="opacity-0 scale-95 -translate-y-1"
      x-bind:aria-hidden="!open"
      role="menu"
      class="absolute right-0 top-[calc(100%+0.5rem)] z-50 min-w-[13rem] origin-top-right overflow-hidden rounded-sm bg-secondary-surface hover:text-primary shadow-xl shadow-black/10 "
      style="display: none;"
    >

      <ul role="none" class="!pl-0 bg-body-bg list-none border border-focus ">
        {% for action in items %}
          {% set title_text = action.title|default('')|striptags %}
          {% set is_logout = 'log' in title_text|lower and 'out' in title_text|lower %}
          {% set label = is_logout ? title_text : 'View Profile' %}

          <li role="none" class="{{ loop.last and is_logout ? 'border-t border-gray-100' : '' }}">
            <a
              href="{{ action.url|default('#') }}"
              role="menuitem"
              class="flex items-center gap-2.5 px-4 py-2.5 text-sm hover:text-body font-medium transition-colors duration-100 hover:bg-primary focus-visible:bg-gray-50 focus-visible:outline-none"
              x-on:click="open = false"
            >
              {% if is_logout %}
                <svg class="h-4 w-4 shrink-0 opacity-80" viewBox="0 0 16 16" fill="none"
                     aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 14H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h3"
                        stroke="currentColor" stroke-width="1.5"
                        stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M11 11l3-3-3-3M14 8H6"
                        stroke="currentColor" stroke-width="1.5"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% else %}
                <svg class="h-4 w-4 shrink-0 opacity-60" viewBox="0 0 16 16" fill="none"
                     aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="8" cy="5.5" r="2.5"
                          stroke="currentColor" stroke-width="1.5"/>
                  <path d="M2.5 13.5c0-2.485 2.462-4.5 5.5-4.5s5.5 2.015 5.5 4.5"
                        stroke="currentColor" stroke-width="1.5"
                        stroke-linecap="round"/>
                </svg>
              {% endif %}
              {{ label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

  {% else %}

    {# ── Trigger (logged out) ── #}
    <button
      type="button"
      x-on:mouseenter="open = true"
      x-on:click="open = !open"
      x-bind:aria-expanded="open"
      aria-haspopup="true"
      class="flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-semibold text-gray-800 transition-all duration-150 focus-visible:ring-2"
    >
      <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold uppercase tracking-wide text-gray-900">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
      </span>
    </button>

    {# ── Dropdown panel (logged out) ── #}
    <div
      x-show="open"
      x-on:mouseleave="open = false"
      x-on:click.outside="open = false"
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
      x-transition:enter-end="opacity-100 scale-100 translate-y-0"
      x-transition:leave="transition ease-in duration-100"
      x-transition:leave-start="opacity-100 scale-100 translate-y-0"
      x-transition:leave-end="opacity-0 scale-95 -translate-y-1"
      x-bind:aria-hidden="!open"
      role="menu"
      class="absolute right-0 top-[calc(100%+0.5rem)] bg-surface-primary z-50 min-w-[13rem] origin-top-right overflow-hidden rounded-sm shadow-xl shadow-black/10 text-body"
      style="display: none;"
    >
      <ul role="none" class="!pl-0 list-none border border-focus">
        <li role="none">
          <a href="/user/login"
            role="menuitem"
            class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors duration-100 hover:bg-primary focus-visible:outline-none"
            x-on:click="open = false"
          >
            Log in
          </a>
        </li>
        <li role="none" class="border-t border-gray-100">
          <a href="/user/register"
            role="menuitem"
            class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors duration-100 hover:bg-primary focus-visible:outline-none"
            x-on:click="open = false"
          >
            Sign up
          </a>
        </li>
      </ul>
    </div>

  {% endif %}
</div>
