{% set size_classes = {
  xs: 'px-2 py-1 text-xs',
  sm: 'px-2 py-1 text-sm',
  md: 'px-3 py-1.5 text-sm',
  lg: 'px-4 py-2 text-base',
  xl: 'px-5 py-2.5 text-lg'
} %}
{% set size_class = size_classes[size|default('md')] %}
{% set pagination_heading_level = pagination_heading_level|default('h4') %}

{% if items %}
  <nav class="pager flex justify-center items-center my-6" role="navigation" aria-labelledby="{{ heading_id|default('') }}">
    <{{ pagination_heading_level }} id="{{ heading_id|default('') }}" class="sr-only">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="pager__items flex items-center gap-1 list-none p-0 m-0">

      {# First Page #}
      {% if items.first %}
        <li class="pager__item pager__item--first">
          <a href="{{ items.first.href }}" title="{{ 'Go to first page'|t }}"
             class="{{ size_class }} inline-flex border border-border bg-surface text-body hover:bg-surface-hover transition-colors">
            {{ items.first.text|default('First'|t) }}
          </a>
        </li>
      {% endif %}

      {# Previous Page #}
      {% if items.previous %}
        <li class="pager__item pager__item--previous">
          <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev"
             class="{{ size_class }} inline-flex border border-border bg-surface text-body hover:bg-surface-hover transition-colors">
            {{ items.previous.text|default('Previous'|t) }}
          </a>
        </li>
      {% endif %}

      {# Ellipsis for Previous Pages #}
      {% if ellipses.previous %}
        <li class="pager__item pager__item--ellipsis" role="presentation">
          <span class="px-2 py-1.5 text-sm text-muted" aria-hidden="true">…</span>
        </li>
      {% endif %}

      {# Page Numbers #}
      {% for key, item in items.pages %}
        <li class="pager__item{{ current == key ? ' pager__item--current is-active bg-primary' : '' }}">
          {% if current == key %}
            <span title="{{ 'Current page'|t }}"
               class="{{ size_class }} inline-flex border border-primary bg-primary text-on-primary font-semibold">
              <span class="visually-hidden">{{ 'Current page'|t }}</span>
              <span aria-hidden="true">{{ key }}</span>
            </span>
          {% else %}
            <a href="{{ item.href }}" title="{{ 'Go to page @key'|t({'@key': key}) }}"
               class="{{ size_class }} inline-flex border border-border bg-surface text-body hover:bg-surface-hover transition-colors">
              {{ key }}
            </a>
          {% endif %}
        </li>
      {% endfor %}

      {# Ellipsis for Next Pages #}
      {% if ellipses.next %}
        <li class="pager__item pager__item--ellipsis" role="presentation">
          <span class="px-2 py-1.5 text-sm text-muted" aria-hidden="true">…</span>
        </li>
      {% endif %}

      {# Next Page #}
      {% if items.next %}
        <li class="pager__item pager__item--next">
          <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next"
             class="{{ size_class }} inline-flex border border-border bg-surface text-body hover:bg-surface-hover transition-colors">
            {{ items.next.text|default('Next'|t) }}
          </a>
        </li>
      {% endif %}

      {# Last Page #}
      {% if items.last %}
        <li class="pager__item pager__item--last">
          <a href="{{ items.last.href }}" title="{{ 'Go to last page'|t }}"
             class="{{ size_class }} inline-flex border border-border bg-surface text-body hover:bg-surface-hover transition-colors">
            {{ items.last.text|default('Last'|t) }}
          </a>
        </li>
      {% endif %}

    </ul>
  </nav>
{% endif %}
