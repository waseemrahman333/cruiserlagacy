{#
/**
 * @file
 * Color Theme Switcher component.
 *
 * Renders a row of circular color swatches — one per Tailpine theme.
 * Alpine.js handles instant theme switching via the data-theme attribute on
 * <html>, and persists the user's choice to localStorage.
 *
 * A synchronous inline <script> in <head> (injected by
 * tailpine_page_attachments_alter) restores the localStorage value before
 * Alpine loads, preventing a flash of the server-configured theme.
 *
 * Available props:
 * - attributes: HTML attributes for the wrapper element.
 * - themes: Keyed array of theme data — each entry has label, primary,
 *   secondary, and bg hex color values.
 * - current_theme: Server-configured active theme name (fallback default).
 * - show_labels: Boolean — display theme name below each swatch.
 */
#}
<div
  x-data="{
    activeTheme: '{{ current_theme }}',
    serverTheme: '{{ current_theme }}',
    init() {
      try {
        var stored = localStorage.getItem('tailpine_color_theme');
        if (stored) {
          this.activeTheme = stored;
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch(e) {}
    },
    setTheme(name) {
      this.activeTheme = name;
      document.documentElement.setAttribute('data-theme', name);
      try { localStorage.setItem('tailpine_color_theme', name); } catch(e) {}
    },
    resetTheme() {
      this.activeTheme = this.serverTheme;
      document.documentElement.setAttribute('data-theme', this.serverTheme);
      try { localStorage.removeItem('tailpine_color_theme'); } catch(e) {}
    }
  }"
  class="color-switcher !block "
  {{ attributes }}
>
  <div
    class="color-switcher__swatches w-full mx-auto max-w-480 flex justify-center items-center gap-2.5 py-3"
    role="group"
    aria-label="{{ 'Select color theme'|t }}"
  >
    {% for key, theme in themes %}
      <button
        type="button"
        class="color-switcher__swatch"
        :class="{ 'color-switcher__swatch--active': activeTheme === '{{ key }}' }"
        @click="setTheme('{{ key }}')"
        title="{{ theme.label }}"
        aria-label="{{ 'Switch to @theme theme'|t({'@theme': theme.label}) }}"
        :aria-pressed="(activeTheme === '{{ key }}').toString()"
        style="--swatch-primary: {{ theme.primary }}; --swatch-secondary: {{ theme.secondary }}; --swatch-bg: {{ theme.bg }};"
      >
        <span class="color-switcher__swatch-circle" aria-hidden="true"></span>
        {% if show_labels %}
          <span class="color-switcher__swatch-label">{{ theme.label }}</span>
        {% endif %}
      </button>
    {% endfor %}

    <button
      type="button"
      class="color-switcher__reset"
      :class="{ 'color-switcher__reset--active': activeTheme === serverTheme }"
      @click="resetTheme()"
      title="{{ 'Reset to default theme'|t }}"
      aria-label="{{ 'Reset to default theme'|t }}"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
        <path d="M3 3v5h5"/>
      </svg>
    </button>
  </div>
</div>
