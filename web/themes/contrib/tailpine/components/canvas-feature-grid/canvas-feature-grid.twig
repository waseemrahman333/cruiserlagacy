{#
/**
 * Feature Grid (Canvas) — parent
 *
 * Variables: layout, columns, bg_color
 * Slots: items
 *
 * Theme tokens: bg-body-bg, bg-primary, bg-secondary, bg-tertiary, bg-surface, bg-surface-alt,
 *               bg-dark, text-body, text-on-primary, text-body-bg, text-muted
 */
#}
{% set safe_layout  = layout|default('icon-top')|striptags %}
{% set safe_columns = columns|default('3')|striptags %}
{% set safe_bg      = bg_color|default('default')|striptags %}

{% set bg_map = {
  'default':     'bg-body-bg text-body',
  'primary':     'bg-primary text-on-primary',
  'secondary':   'bg-secondary text-on-primary',
  'tertiary':    'bg-tertiary text-body-bg',
  'light':       'bg-surface text-body',
  'alt':         'bg-surface-alt text-body',
  'dark':        'bg-dark text-body-bg',
  'gradient':    'bg-gradient-to-r from-primary to-secondary text-on-primary',
  'transparent': 'bg-transparent text-body',
} %}
{% set bg_class = bg_map[safe_bg]|default('bg-body-bg text-body') %}

{% set col_map = {
  '2': 'md:grid-cols-2',
  '3': 'md:grid-cols-3',
  '4': 'md:grid-cols-2 lg:grid-cols-4',
} %}
{% set col_class = col_map[safe_columns]|default('md:grid-cols-3') %}

<div
  class="canvas-feature-grid canvas-feature-grid--{{ safe_layout }} w-full {{ bg_class }}"
  data-layout="{{ safe_layout }}"
  {{ attributes }}
>
  <div class="w-full max-w-[1920px] mx-auto px-5 md:px-12 xl:px-24 py-16 grid grid-cols-1 {{ col_class }} gap-6 md:gap-8">
    {% block items %}
      <div class="text-muted text-sm col-span-full text-center">{{ 'Add canvas-feature-griditem components here.'|t }}</div>
    {% endblock %}
  </div>
</div>
