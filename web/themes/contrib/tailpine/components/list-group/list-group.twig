{#
/**
 * List Group Component
 * 
 * Styled list for displaying series of content.
 */
#}

{% set is_flush = flush|default(false) %}

<ul class="{{ is_flush ? '' : 'border border-border' }} divide-y divide-border">
  {% for item in items %}
    <li class="{{ is_flush ? 'px-0' : 'px-4' }} py-3 hover:bg-surface transition-colors">
      {% if item.link %}
        <a href="{{ item.link }}" class="block text-body hover:text-primary transition-colors">
          {{ item.content }}
        </a>
      {% else %}
        {{ item.content }}
      {% endif %}
    </li>
  {% endfor %}
</ul>

