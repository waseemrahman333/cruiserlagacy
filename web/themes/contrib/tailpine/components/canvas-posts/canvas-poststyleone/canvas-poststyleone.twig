  <div class="card flex flex-col gap-6 border-1 border-secondary bg-body-bg  p-6">
                {% if imageurl %}
                <img class=" h-full w-full" src="{{ imageurl.src }}" alt="{{ imageurl.alt }}" loading="lazy"/>
                {% endif %}
                {% if subtitle or date %}
                <div class="text-tertiary-300">{{ subtitle }} | {{ date }}</div>
                {% endif %}
                <div class="div flex flex-col gap-2">
                {% if title %}
                    <h2 class="text-2xl font-medium text-body">{{ title }}</h2>
                {% endif %}
                {% if description %}
                    <div class="text-tertiary-300">{{ description }}</div>
                {% endif %}
                </div>
                <div class="mt-auto">
                 {{ cta }}
                 </div>
            </div>
