{# ---------------------------------------------------------------------------
 # Post Wrapper Component
 # --------------------------------------------------------------------------- #}

<div
  {{ attributes.addClass(
    'postwrapper',
    'max-w-[1920px]',
    'w-full',
    'mx-auto',
    'flex',
    'flex-col',
    'gap-10',
    'py-10',
    'lg:py-20',
    'px-5',
    'md:px-12.5',
    'lg:px-24'
  ) }}
>
  <!-- Top Header -->
    <div class="postTopContent flex items-center justify-between gap-6 flex-wrap">
      {% if title %}
        <h2 class="font-medium text-[clamp(26px,5vw,46px)] text-body">
          {{ title }}
        </h2>
      {% endif %}

      {% if cta %}
        <div class=" min-w-8 min-h-4">
          {{ cta }}
        </div>
      {% endif %}
    </div>

  <!-- Posts Grid -->
  {% if content %}
    <div
      class="
        blog-posts
        grid
        grid-cols-1
        md:grid-cols-2
        xl:grid-cols-3
        gap-8


      "
    >
      {{ content }}
    </div>
  {% endif %}
</div>
{# ---------------------------------------------------------------------------
 # End Post Wrapper Component
 # --------------------------------------------------------------------------- #}
