  "84px": "px-10.5 md:px-15 xl:px-21",
  "92px": "px-11.5 md:px-16 xl:px-23",
  "96px": "px-12 md:px-16 xl:px-24",
  "100px": "px-12.5 md:px-18 xl:px-25",
  "112px": "px-14 md:px-20 xl:px-28",
  "120px": "px-15 md:px-22 xl:px-30",
  "128px": "px-16 md:px-24 xl:px-32",
  "140px": "px-17.5 md:px-26 xl:px-35",
  "156px": "px-19.5 md:px-30 xl:px-39",
  "160px": "px-20 md:px-32 xl:px-40",
  "192px": "px-24 md:px-40 xl:px-48",
  "224px": "px-28 md:px-48 xl:px-56"
