{#
/**
 * Base Testimonial Component with Two Design Styles
 * 
 * Style One: Quote icon with side profile image
 * Style Two: Centered layout with decorative top dots
 */
#}

{% set author_heading = heading_level|default(2) %}
{% set author_image = imageurl.src|default('') %}
{% set author_alt = imageurl.alt|default('') %}
{% set style = design_style|default('style_one') %}

