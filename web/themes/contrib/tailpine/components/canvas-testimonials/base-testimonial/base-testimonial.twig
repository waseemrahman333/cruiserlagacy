{% set gap_variants = {
  "0": "gap-0",
  "4": "gap-1",
  "8": "gap-2",
  "12": "gap-3",
  "16": "gap-4",
  "20": "gap-5",
  "24": "gap-5 xl:gap-6",
  "32": "gap-6 xl:gap-8",
  "40": "gap-6 md:gap-8 xl:gap-10",
  "48": "gap-8 md:gap-10 xl:gap-12"
} %}

{% set border_variants = {
  'primary': 'border-primary',
  'secondary': 'border-secondary',
  'tertiary': 'border-tertiary',
  'light': 'border-border',
  'medium': 'border-border',
  'dark': 'border-body',
  'black': 'border-black',
  'white': 'border-border'
} %}

{% set bg_variants = {
  'primary': 'bg-primary text-body-bg',
  'secondary': 'bg-secondary text-on-primary',
  'tertiary': 'bg-tertiary text-body-bg',
  'light': 'bg-surface text-body',
  'medium': 'bg-surface-alt text-body',
  'dark': 'bg-body text-body-bg',
  'transparent': 'bg-transparent',
  'gradient_bg': 'bg-gradient-to-r from-primary to-secondary text-body-bg'
} %}

{% set card_padding_inline_class = padding_inline_variants[card_padding_inline]|default('px-0') %}
{% set card_padding_block_class = padding_block_variants[card_padding_block]|default('py-0') %}
{% set content_padding_inline_class = padding_inline_variants[content_padding_inline]|default('px-0') %}
{% set content_padding_block_class = padding_block_variants[content_padding_block]|default('py-0') %}

{# ========== STYLE ONE: Quote with Side Profile ========== #}
{% if style == 'style_one' %}

<figure class="{{ card_padding_inline_class }} {{ card_padding_block_class }} {{ bg_variants[bg_color]|default('primary') }} flex flex-col {{ gap_variants[gap]|default('gap-2') }}  {{ enable_border ? "border-3" : "" }} {{ border_variants[border_color]|default('primary') }} rounded-{{ border_radius }}">
  
  {# Testimonial Card #}
  <blockquote class="relative flex flex-col justify-between bg-surface text-body {{ content_padding_inline_class }} {{ content_padding_block_class }} w-full flex-grow">
    
    <div class="flex gap-5 h-full">
      {# Decorative Quote Icon #}
      <div class="w-fit h-10 pt-2 flex-shrink-0" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="39" height="31" viewBox="0 0 39 31" fill="currentColor" class="text-muted">
          <path d="M14.1614 30.6289H0.608784V20.6792C0.608784 10.0761 4.60791 3.39272 12.6061 0.628906L15.2722 6.43293C10.2363 8.14147 7.69365 11.6088 7.64427 16.8349H14.1614V30.6289ZM36.9712 30.6289H23.4186V20.6792C23.4186 10.0259 27.4424 3.34247 35.49 0.628906L38.082 6.43293C33.0955 8.09122 30.5528 11.5586 30.4541 16.8349H36.9712V30.6289Z"/>
        </svg>
      </div>
      
      {# Testimonial Text #}
      <div class="flex h-full flex-col justify-between {{ gap_variants[content_gap]|default('gap-2') }}">
        {% if description %}
          <div class="text-sm leading-7">
            {{ description }}
          </div>
        {% endif %}

        {# Rating Stars #}
        {% if show_rating %}
          {% set rating_stars %}
            {% block rating %}{% endblock %}
          {% endset %}
          {% if rating_stars|trim is not empty %}
            <div class="flex gap-1">
              <div class="h-fit min-w-20">
                {{ rating_stars }}
              </div>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
    
  </blockquote>
  
  {# Author Profile #}
  <figcaption class="profile flex items-center gap-5">
    {% if author_image %}
      <div class="image w-16 rounded-full h-16 border-2 border-primary overflow-hidden flex-shrink-0">
        <img 
          src="{{ author_image }}" 
          alt="{{ author_alt }}" 
          class="w-full h-full object-cover"
          loading="lazy"
        >
      </div>
    {% endif %}
    
    <div class="info">
      {% if name %}
        <h{{ author_heading }} class="text-xl font-bold leading-tight">
          {{ name }}
        </h{{ author_heading }}>
      {% endif %}
      
      {% if subtitle %}
        <div class="text-sm leading-relaxed">
          {{ subtitle }}
        </div>
      {% endif %}
    </div>
  </figcaption>
</figure>

{# ========== STYLE TWO: Centered with Top Dots ========== #}
{% else %}


{# ========== STYLE TWO: Centered with Top Dots ========== #}

  <div class="card {{ card_padding_inline_class }} {{ bg_variants[bg_color]|default('primary') }} {{ card_padding_block_class }} relative  {{ enable_border ? "border-3" : "" }} {{ border_variants[border_color]|default('primary') }} rounded-{{ border_radius }} w-full {{ content_padding_inline_class }} {{ content_padding_block_class }} flex flex-col justify-center items-center {{ gap_variants[gap]|default('gap-7.5') }} 
    before:content-['']  before:w-4 before:rounded-full before:h-4 before:bg-primary before:absolute before:-top-2.5 before:left-[40%] before:z-30 
    after:content-[''] after:rounded-full after:w-4 after:h-4 after:bg-primary after:absolute after:-top-2.5 after:right-[40%] after:z-30">
    
    {# Spacer that inherits parent background - hides border between dots #}
    <div class="absolute -top-[3px] left-1/2 transform -translate-x-1/2 w-[20%] h-[4px] bg-inherit z-20"></div>
    
    {# Profile Image #}
    <div class="image border-3 rounded-full w-25 h-25 border-primary overflow-clip flex-shrink-0">
      {% if author_image %}
        <img class="h-full w-full object-cover" src="{{ author_image }}" alt="{{ author_alt }}" loading="lazy"/>
      {% endif %}
    </div>
    
    {# Content Info #}
    <div class="info flex flex-col {{ gap_variants[content_gap]|default('gap-5') }} w-full">
      
      {# Description #}
      {% if description %}
        <div class="text-center text-sm md:text-base leading-relaxed">
          {{ description }}
        </div>
      {% endif %}
      
      {# Author Info #}
      {% if name or subtitle %}
        <div class="flex flex-col gap-1">
          {% if name %}
            <h{{ author_heading }} class="text-center font-bold text-xl md:text-2xl">
              {{ name }}
            </h{{ author_heading }}>
          {% endif %}
          
          {% if subtitle %}
            <div class="text-center font-medium text-base md:text-lg">
              {{ subtitle }}
            </div>
          {% endif %}
        </div>
      {% endif %}
      

      
    </div>
    
  </div>

{% endif %}
