{% set padding_inline_variants = {
  "0px": "px-0",
  "8px": "px-1 md:px-1.5 xl:px-2",
  "10px": "px-1.5 md:px-2 xl:px-2.5",
  "16px": "px-2 md:px-3 xl:px-4",
  "18px": "px-2.5 md:px-3.5 xl:px-4.5",
  "20px": "px-2.5 md:px-4 xl:px-5",
  "24px": "px-3 md:px-4.5 xl:px-6",
  "28px": "px-3.5 md:px-5 xl:px-7",
  "32px": "px-4 md:px-6 xl:px-8",
  "36px": "px-4.5 md:px-7 xl:px-9",
  "40px": "px-5 md:px-8 xl:px-10",
  "44px": "px-5.5 md:px-9 xl:px-11",
  "48px": "px-6 md:px-10 xl:px-12",
  "52px": "px-6.5 md:px-11 xl:px-13",
  "56px": "px-7 md:px-12 xl:px-14",
  "64px": "px-8 md:px-12 xl:px-16",
  "70px": "px-9 md:px-13 xl:px-[4.375rem]",
  "74px": "px-9 md:px-14 xl:px-[4.625rem]",
