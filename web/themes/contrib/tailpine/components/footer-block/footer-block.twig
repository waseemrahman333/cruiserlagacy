{#
  content-block.twig

  All Tailwind classes are built from static maps keyed by prop values.
  Every class string is fully static so Tailwind JIT can scan and include them.
  No dynamic string concatenation is used for class names.
#}

{# ══════════════════════════════════════════
   HEADING SIZE MAP
   Every value is a complete static Tailwind class.
   JIT scans these and includes them all.
══════════════════════════════════════════ #}
{% set size_map = {
  xs:    'text-xs',
  sm:    'text-sm',
  base:  'text-base',
  lg:    'text-lg',
  xl:    'text-xl',
  '2xl': 'text-2xl',
  '3xl': 'text-3xl',
  '4xl': 'text-4xl',
  '5xl': 'text-5xl',
  '6xl': 'text-6xl',
  '7xl': 'text-7xl'
} %}

{# ══════════════════════════════════════════
   HEADING WEIGHT MAP
══════════════════════════════════════════ #}
{% set weight_map = {
  thin:       'font-thin',
  extralight: 'font-extralight',
  light:      'font-light',
  normal:     'font-normal',
  medium:     'font-medium',
  semibold:   'font-semibold',
  bold:       'font-bold',
  extrabold:  'font-extrabold',
  black:      'font-black'
} %}

{# ══════════════════════════════════════════
   HEADING ALIGNMENT MAP
   text  → text-align on the heading element
   self  → align-self on the heading wrapper (for underline positioning)
══════════════════════════════════════════ #}
{% set heading_align_map = {
  left:   { text: 'text-left',   self: 'self-start',  items: 'items-start'  },
  center: { text: 'text-center', self: 'self-center',  items: 'items-center' },
  right:  { text: 'text-right',  self: 'self-end',    items: 'items-end'    }
} %}

{# ══════════════════════════════════════════
   CONTENT ALIGNMENT MAP
   items  → align-items on the content flex wrapper
   text   → text-align inside content
   self   → align-self for the inner content div
══════════════════════════════════════════ #}
{% set content_align_map = {
  left:   { items: 'items-start',  text: 'text-left',   self: ''           },
  center: { items: 'items-center', text: 'text-center', self: 'mx-auto'    },
  right:  { items: 'items-start md:items-end',    text: 'text-right',  self: 'md:ml-auto'    }
} %}

{# ══════════════════════════════════════════
   UNDERLINE WIDTH MAP
   Static inline style values — safe for JIT
   because these are used in style="" not class=""
══════════════════════════════════════════ #}
{% set width_map = {
  'fit':  'fit-content',
  'full': '100%',
  '10': '10%',
  '20': '20%',
  '25': '25%',
  '33': '33.333%',
  '40': '40%',
  '50': '50%',
  '60': '60%',
  '66': '66.666%',
  '75': '75%',
  '80': '80%',
  '90': '90%'
} %}

{# ══════════════════════════════════════════
   UNDERLINE THICKNESS MAP
   border-b-[0.5px] needs JIT arbitrary value.
   All others are standard Tailwind classes.
══════════════════════════════════════════ #}
{% set thickness_map = {
  half: 'border-b-[0.5px]',
  px:   'border-b',
  '2':  'border-b-2',
  '4':  'border-b-4',
  '8':  'border-b-8'
} %}

{# ══════════════════════════════════════════
   UNDERLINE SPACING MAP  (mt between heading and line)
══════════════════════════════════════════ #}
{% set underline_spacing_map = {
  none: 'mt-0',
  xs:   'mt-1',
  sm:   'mt-2',
  md:   'mt-3',
  lg:   'mt-4',
  xl:   'mt-6'
} %}

{# ══════════════════════════════════════════
   CONTENT SPACING MAP  (mt between underline/heading and content)
══════════════════════════════════════════ #}
{% set content_spacing_map = {
  none: 'mt-0',
  xs:   'mt-2',
  sm:   'mt-3',
  md:   'mt-4',
  lg:   'mt-6',
  xl:   'mt-8',
  '2xl':'mt-12'
} %}

{# ══════════════════════════════════════════
   RESOLVE ALL PROPS WITH FALLBACKS
══════════════════════════════════════════ #}

{# Heading #}
{% set h_size      = size_map[heading_size     ?? 'lg']   ?? 'text-lg'   %}
{% set h_weight    = weight_map[heading_weight ?? 'bold'] ?? 'font-bold' %}
{% set h_align     = heading_align_map[heading_alignment ?? 'left'] %}
{% set h_color     = heading_color ?? 'text-current' %}
{% set h_text      = heading ?? '' %}

{# Underline #}
{% set show_ul      = show_underline is defined ? show_underline : true %}
{% set ul_w         = width_map[underline_width    ?? 'full'] ?? '100%' %}
{% set content_width_class  = width_map[content_width    ?? 'full'] ?? '100%' %}
{% set ul_thickness = thickness_map[underline_thickness       ?? 'px']   ?? 'border-b' %}
{# {% set ul_color     = underline_color   ?? 'border-current' %} #}
{% set ul_spacing   = underline_spacing_map[underline_spacing ?? 'sm']   ?? 'mt-2' %}

{# Content #}
{% set c_align   = content_align_map[content_alignment ?? 'left'] %}
{% set c_spacing = content_spacing_map[content_spacing ?? 'none']   ?? '0' %}

{# ══════════════════════════════════════════
   RENDER
══════════════════════════════════════════ #}
<div {{ attributes.addClass('content-block w-full flex flex-col w-full h-full') }}>

  {# ── HEADING + UNDERLINE ── #}

  {% if h_text and show_title %}
    <div class="content-block__heading-wrap flex flex-col {{ h_align.items }}">
      
      <h3 class="content-block__heading 
                          leading-tight tracking-wide uppercase
                          {{ h_size }}
                          {{ h_weight }}
                          {{ h_align.text }}
                          {{ h_color }}">
        {{- h_text -}}
      </h3>

      {# Underline — width via inline style, all other styles via Tailwind classes #}
      {% if show_ul %}
        <div class="content-block__underline border-current
                    {{ ul_thickness }}
                    {{ ul_spacing }}"
             style="width: {{ ul_w }};">
        </div>
      {% endif %}

    </div>
  {% endif %}

  {# ── SLOT CONTENT ── #}

      {% if show_content %}
          <div class="content-block__content
                w-full flex flex-col 
                {{ c_align.items }}
                {{ h_text ? c_spacing : '' }}">
      {% set link_block_content %}
        {% block content %}{% endblock %}
      {% endset %}
      {% if link_block_content|trim is not empty %}
        <div class=" content-block__inner
                  {{ c_align.text }}
                  {{ c_align.self }}"
                  style="width: {{ content_width_class}};" >
          {{ link_block_content }}
        </div>
      {% endif %}
         </div>
    {% endif %}

</div>
