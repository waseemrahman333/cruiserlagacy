{% if context.list_style %}
  {%- set wrapper_attributes = (wrapper_attributes|default(create_attribute())).addClass('item-list--' ~ context.list_style) %}
  {%- set attributes = (attributes|default(create_attribute())).addClass('item-list__' ~ context.list_style) %}
{% endif %}

{% if items is not empty or empty is not empty -%}
  {%- set is_search = context is not empty and context.plugin is defined -%}
  <div class="item-list p-6 max-w-3xl mx-auto my-6{{ is_search ? ' border border-border' : '' }}">
    {%- if title is not empty -%}
      <h3 class="text-2xl font-semibold text-primary mb-4 border-b border-border pb-2">{{ title }}</h3>
    {%- endif -%}

    {%- if items -%}
      {%- if is_search -%}
        {%
          set list_classes = [
            'list-none',
            'space-y-4',
            'text-body',
          ]
        %}
        <{{ list_type }}{{ (attributes|default(create_attribute())).addClass(list_classes) }}>
          {%- for item in items %}
            <li>{{ item.value }}</li>
          {%- endfor -%}
        </{{ list_type }}>
      {%- else -%}
        {%
          set list_classes = [
            list_type == 'ul' ? 'list-disc' : 'list-decimal',
            'list-inside',
            'space-y-1',
            'text-body',
            'pl-4',
          ]
        %}
        <{{ list_type }}{{ (attributes|default(create_attribute())).addClass(list_classes) }}>
          {%- for item in items %}
            <li class="hover:text-primary transition-colors duration-200">{{ item.value }}</li>
          {%- endfor -%}
        </{{ list_type }}>
      {%- endif -%}
    {%- else -%}
      <p class="text-muted italic">{{ empty }}</p>
    {%- endif -%}
  </div>
{%- endif %}
