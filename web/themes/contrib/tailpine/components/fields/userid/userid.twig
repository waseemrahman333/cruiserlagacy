{% if not is_inline and field_name is not empty %}
  {% include "field.html.twig" %}
{% else %}
{%
  set classes = [
    'field',
    'field--name-' ~ field_name|clean_class,
    'field--type-' ~ field_type|clean_class,
    'field--label-' ~ label_display,
    'text-tertiary underline',
  ]
%}

<span{{ (attributes|default(create_attribute())).addClass(classes) }}>
  {%- for item in items -%}
    {{ item.content }}
  {%- endfor -%}
</span>

{% endif %}
