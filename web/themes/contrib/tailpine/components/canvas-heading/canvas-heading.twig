{# ===============================
   Mapping
================================ #}

{# map  text and underline alignment #}

{% set alignment_variants = {
  left: { text: 'text-left', underline: 'after:left-0' },
  center: { text: 'text-center', underline: 'after:left-1/2 after:-translate-x-1/2' },
  right: { text: 'text-right', underline: 'after:right-0' }
} %}

{#  size maping #}
{% set size_classes = {
  'text-8xl(96px)': 'text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl',
  'text-7xl(72px)': 'text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl',
  'text-6xl(60px)': 'text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl',
  'text-5xl(48px)': 'text-2xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl',
  'text-4xl(36px)': 'text-lg sm:text-xl md:text-2xl lg:text-3xl xl:text-4xl',
  'text-3xl(30px)': 'text-base sm:text-lg md:text-xl lg:text-2xl xl:text-3xl',
  'text-2xl(24px)': 'text-sm sm:text-base md:text-lg lg:text-xl xl:text-2xl',
  'text-xl(20px)': 'text-sm md:text-base lg:text-lg xl:text-xl',
  'text-lg(18px)': 'text-sm lg:text-lg ',
  'text-base(16px)': 'text-sm  xl:text-base',
  'text-sm(14px)': ' sm:text-xs md:text-sm',
  'text-xsm(12px)': 'text-xs',
} %}

    {# underline and title widht mapping  #}
   
{% set title_width_map = {
  '10%': { underline: 'after:w-[10%]', width: 'lg:w-[10%]' },
  '20%': { underline: 'after:w-[20%]', width: 'lg:w-[20%]' },
  '25%': { underline: 'after:w-1/4', width: 'lg:w-1/4' },
  '30%': { underline: 'after:w-[30%]', width: 'lg:w-[30%]' },
  '33%': { underline: 'after:w-1/3', width: 'lg:w-1/3' },
  '40%': { underline: 'after:w-[40%]', width: 'lg:w-[40%]' },
  '50%': { underline: 'after:w-1/2', width: 'lg:w-1/2' },
  '60%': { underline: 'after:w-[60%]', width: 'lg:w-[60%]' },
  '66%': { underline: 'after:w-2/3', width: 'lg:w-2/3' },
  '70%': { underline: 'after:w-[70%]', width: 'lg:w-[70%]' },
  '75%': { underline: 'after:w-3/4', width: 'lg:w-3/4' },
  '80%': { underline: 'after:w-[80%]', width: 'lg:w-[80%]' },
  '90%': { underline: 'after:w-[90%]', width: 'lg:w-[90%]' },
  'full': { underline: 'after:w-full', width: 'lg:w-full' },
  "fit":{ underline: 'after:w-fit', width: 'w-fit' },
} %}


{# text, text bg and underline color vairants #}

{% set color_variants = {
  'primary':     { bg: 'bg-primary text-primary-content', text: 'text-primary', underline: 'after:bg-primary' },
  'secondary':   { bg: 'bg-secondary text-secondary-content', text: 'text-secondary', underline: 'after:bg-secondary' },
  'tertiary':    { bg: 'bg-tertiary text-tertiary-content', text: 'text-tertiary', underline: 'after:bg-tertiary' },
  'success':     { bg: 'bg-success text-success-content', text: 'text-success', underline: 'after:bg-success' },
  'warning':     { bg: 'bg-warning text-warning-content', text: 'text-warning', underline: 'after:bg-warning' },
  'error':       { bg: 'bg-error text-error-content', text: 'text-error', underline: 'after:bg-error' },
  'info':        { bg: 'bg-info text-info-content', text: 'text-info', underline: 'after:bg-info' },
  'body':        { bg: 'bg-body text-body-bg', text: 'text-body', underline: 'after:bg-body' },
  'body-bg':     { bg: 'bg-body-bg text-body', text: 'text-body-bg', underline: 'after:bg-body-bg' },
  'heading':     { text: 'text-heading' },
  'surface-100': { bg: 'bg-surface-100 text-body', text: 'text-surface-100', underline: 'after:bg-surface-100' },
  'surface-200': { bg: 'bg-surface-200 text-body', text: 'text-surface-200', underline: 'after:bg-surface-200' },
  'surface-300': { bg: 'bg-surface-300 text-body', text: 'text-surface-300', underline: 'after:bg-surface-300' },
  'border':      { bg: 'bg-border', underline: 'after:bg-border' },
  'focus-ring':  { bg: 'bg-focus', underline: 'after:bg-focus' },
  'shadow':      { bg: 'bg-shadow', underline: 'after:bg-shadow' },
  'dark':        { bg: 'bg-dark text-content-on-dark', text: 'text-dark', underline: 'after:bg-dark' },
  'transparent': { bg: 'bg-transparent' },
  'none':        { bg: 'bg-transparent', underline: 'after:bg-transparent' }
} %}


{# padding block and inline variants #}

{% set padding_variants = {
  none: { block: 'py-0', inline: 'px-0' },
  xs: { block: 'py-1 md:py-1.5 xl:py-2', inline: 'px-1 md:px-1.5 xl:px-2' },
  sm: { block: 'py-2 md:py-3 xl:py-4', inline: 'px-2 md:px-3 xl:px-4' },
  md: { block: 'py-3 md:py-4 xl:py-5', inline: 'px-3 md:px-4 xl:px-5' },
  lg: { block: 'py-3 md:py-4.5 xl:py-6', inline: 'px-3 md:px-4.5 xl:px-6' },
  xl: { block: 'py-4 md:py-6 xl:py-8', inline: 'px-4 md:px-6 xl:px-8' },
  '2xl': { block: 'py-5 md:py-8 xl:py-10', inline: 'px-5 md:px-8 xl:px-10' },
  '3xl': { block: 'py-6 md:py-10 xl:py-12', inline: 'px-6 md:px-10 xl:px-12' },
  huge: { block: 'py-8 md:py-12 xl:py-16', inline: 'px-8 md:px-12 xl:px-16' }
} %}


 {#  margin top and left mapping  #}

{% set margin_variants = {
  none: { top: 'mt-0', bottom: 'mb-0' },
  xs: { top: 'mt-1 md:mt-1.5 xl:mt-2', bottom: 'mb-1 md:mb-1.5 xl:mb-2' },
  sm: { top: 'mt-2 md:mt-3 xl:mt-4', bottom: 'mb-2 md:mb-3 xl:mb-4' },
  md: { top: 'mt-3 md:mt-4 xl:mt-5', bottom: 'mb-3 md:mb-4 xl:mb-5' },
  lg: { top: 'mt-3 md:mt-4.5 xl:mt-6', bottom: 'mb-3 md:mb-4.5 xl:mb-6' },
  xl: { top: 'mt-4 md:mt-6 xl:mt-8', bottom: 'mb-4 md:mb-6 xl:mb-8' },
  '2xl': { top: 'mt-5 md:mt-8 xl:mt-10', bottom: 'mb-5 md:mb-8 xl:mb-10' },
  '3xl': { top: 'mt-6 md:mt-10 xl:mt-12', bottom: 'mb-6 md:mb-10 xl:mb-12' },
  huge: { top: 'mt-8 md:mt-12 xl:mt-16', bottom: 'mb-8 md:mb-12 xl:mb-16' }
} %}


{% set underline_offset_map = {
    'xsm': "after:translate-y-[2px]",
    'sm': "after:translate-y-[3px]",
    'base': "after:translate-y-[4px]",
    'medium': "after:translate-y-[8px]",
    'large': "after:translate-y-[12px]",
    'xlarge': "after:translate-y-[16px]",
    'wide': "after:translate-y-[20px]",
    'huge': "after:translate-y-[32px]"

} %}


{% set heading_width_class = title_width_map[heading_text_width].width %}

{% set underline_color_class = color_variants[underline_color].underline %}
{% set underline_class = title_width_map[text_underline_width].underline %}
{% set underline_align_class = alignment_variants[underline_alignment].underline %}
{% set underline_offset_class = underline_offset_map[underline_offset]|default(underline_offset_map.base) %}

{% set tag = 'h' ~ (level|default(2)) %}
{% set size = text_size|default('heading-responsive-4xl') %}
{% set color = text_color|default('default') %}
{% set font_weight = font_weight|default('default') %}
{% set link_url = url|default(null) %}

{# ===============================
   Build Final Class String
================================ #}
 

{# set underline classes #}


{% set underline_classes = underline ? [
  "after:content-[' ']",
  'after:bottom-0',
  'after:absolute',
  underline_align_class,
  underline_offset_class,
  underline_class,
  'after:h-1',
  underline_color_class,
]|join(' ') : '' %}

{# set the spacing_classes padding and margins #}
{% set spacing_classes = [
  margin_variants[margin_bottom].bottom ?? '',
  margin_variants[margin_top].top ?? '',
  padding_variants[padding_block].block ?? '',
  padding_variants[padding_inline].inline ?? '',
]|filter(v => v)|join(' ') %}



{# now combine all the classes into clasess #}
{% set classes = [
  'h-fit',
  'relative',
  'inline-block',
  heading_width_class,
  font_weight,
  underline_classes,
  color_variants[color].text|default(''),
  color_variants[text_bg_color].bg|default(''),
  size_classes[size]|default(''),
  spacing_classes,
  alignment_variants[text_align].text,
  link_url ? 'transition duration-300 hover:opacity-80 hover:-translate-y-0.5' : '',
  heading_classes|default(''),
]|filter(v => v)|join(' ') %}


{# Normalize custom classes #}
{% if heading_classes is defined %}
  {% set classes = classes ~ ' ' ~ (heading_classes is iterable ? heading_classes|join(' ') : heading_classes) %}
{% endif %}

{# ===============================
   Render
================================ #}

<{{ tag }} class="{{ classes }}">

  {% if link_url %}
    <a href="{{ link_url }}" class="inline-block">
      {{ heading_text }}
    </a>
  {% else %}
     {% if highlight_text %}
    {% set parts = heading_text|split(highlight_text, 2) %}

    {{ parts[0] }}

    <span class="{{  color_variants[highlight_color].text|default('') }}">
      {{ highlight_text }}
    </span>

    {% if parts[1] is defined %}
      {{ parts[1] }}
    {% endif %}
  {% else %}
    {{ heading_text }}
  {% endif %}
  {% endif %} 

</{{ tag }}>



