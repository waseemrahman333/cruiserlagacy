<a href="{{ page_url }}" class="flex items-center rounded-sm gap-2 px-2 py-1.5 text-sm font-medium text-muted underline-offset-2 hover:bg-surface-hover hover:text-body focus-visible:underline focus:outline-hidden">
  {% if icons %}
  <div> {{ icons.src }} </div>
  {% endif %}
  {% if list %}
  <span>{{ list }}</span>
  {% endif %}
</a>
