{#
/**
 * Divider (Canvas)
 *
 * Section divider with optional centred label.
 * Five styles: line, wave, zigzag, angle, curve.
 *
 * Available variables:
 * - style: (string) 'line'|'wave'|'zigzag'|'angle'|'curve'. Default: line.
 * - show_label: (bool) Show centred label text. Default: false.
 * - label: (string) Label text. Only rendered when show_label is true.
 * - color: (string) Color token — 'border'|'primary'|'secondary'|'accent'|'muted'.
 *
 * Accessibility:
 * - role="separator" aria-hidden="true" — decorative, not read by screen readers.
 *
 * Theme tokens: text-border, text-primary, text-secondary, text-accent, text-muted,
 *               bg-body-bg (used to mask label background on line style).
 */
#}

{% set safe_style = style|default('line')|striptags %}
{% set safe_label = label|default('')|striptags %}
{% set safe_color = color|default('border')|striptags %}

{% set color_map = {
  'border':    'text-border',
  'primary':   'text-primary',
  'secondary': 'text-secondary',
  'accent':    'text-accent',
  'muted':     'text-muted',
} %}
{% set color_class = color_map[safe_color]|default('text-border') %}

<div
  class="canvas-divider canvas-divider--{{ safe_style }} w-full my-8 {{ color_class }}"
  role="separator"
  aria-hidden="true"
  {{ attributes }}
>

  {% if safe_style == 'line' %}

    {% if show_label and safe_label %}
      <div class="flex items-center gap-4">
        <div class="flex-1 border-t border-current"></div>
        <span class="canvas-divider__label shrink-0 text-sm font-medium text-current uppercase tracking-wider px-2">
          {{ safe_label }}
        </span>
        <div class="flex-1 border-t border-current"></div>
      </div>
    {% else %}
      <div class="border-t border-current w-full"></div>
    {% endif %}

  {% elseif safe_style == 'wave' %}

    <svg
      viewBox="0 0 1200 40"
      preserveAspectRatio="none"
      class="w-full h-8"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M0,20 C150,40 350,0 600,20 C850,40 1050,0 1200,20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>
    {% if show_label and safe_label %}
      <div class="text-center -mt-4">
        <span class="canvas-divider__label inline-block bg-body-bg text-sm font-medium text-current uppercase tracking-wider px-3">
          {{ safe_label }}
        </span>
      </div>
    {% endif %}

  {% elseif safe_style == 'zigzag' %}

    <svg
      viewBox="0 0 1200 20"
      preserveAspectRatio="none"
      class="w-full h-5"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <polyline
        points="0,10 40,0 80,10 120,0 160,10 200,0 240,10 280,0 320,10 360,0 400,10 440,0 480,10 520,0 560,10 600,0 640,10 680,0 720,10 760,0 800,10 840,0 880,10 920,0 960,10 1000,0 1040,10 1080,0 1120,10 1160,0 1200,10"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>

  {% elseif safe_style == 'angle' %}

    <svg
      viewBox="0 0 1200 30"
      preserveAspectRatio="none"
      class="w-full h-6"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <polyline
        points="0,2 600,28 1200,2"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>

  {% elseif safe_style == 'curve' %}

    <svg
      viewBox="0 0 1200 40"
      preserveAspectRatio="none"
      class="w-full h-8"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M0,2 Q600,38 1200,2"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>
    {% if show_label and safe_label %}
      <div class="text-center -mt-4">
        <span class="canvas-divider__label inline-block bg-body-bg text-sm font-medium text-current uppercase tracking-wider px-3">
          {{ safe_label }}
        </span>
      </div>
    {% endif %}

  {% endif %}

</div>
