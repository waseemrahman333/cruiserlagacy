<?php

/**
 * @file
 * Functions to support theming in the Cruiserclassic theme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * Vehicles listing: hide filter labels and show them as the first select
 * option instead of "- Any -", as in the design.
 */
function cruiserclassic_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if ($view && $view->id() === 'gallery') {
    cruiserclassic_gallery_exposed_form($form);
    return;
  }
  if (!$view || $view->id() !== 'vehicles') {
    return;
  }

  $form['#attributes']['class'][] = 'vehicles-filters';
  // Tailpine's form component adds max-w-6xl to every form; use the site width here.
  $form['#attributes']['class'][] = '!max-w-480';

  if (isset($form['search'])) {
    $form['search']['#title_display'] = 'invisible';
    $form['search']['#attributes']['placeholder'] = t('Searching...');
  }

  foreach (['brand', 'model_type', 'series', 'trim'] as $key) {
    if (!isset($form[$key]['#options'])) {
      continue;
    }
    $label = $form['#info']["filter-field_{$key}_target_id"]['label'] ?? $form[$key]['#title'] ?? '';
    if (isset($form[$key]['#options']['All'])) {
      $form[$key]['#options']['All'] = $label;
    }
    $form[$key]['#title_display'] = 'invisible';
  }

  // The brand filter uses the field_vehicle_model field.
  if (isset($form['brand']['#options']['All'])) {
    $form['brand']['#options']['All'] = t('Model Brand');
  }
}

/**
 * Gallery category filter (/gallery): a single select that applies on change.
 */
function cruiserclassic_gallery_exposed_form(array &$form): void {
  $form['#attributes']['class'][] = 'gallery-filter !max-w-none !m-0 flex flex-wrap items-end gap-4';
  if (isset($form['category'])) {
    // Label hidden (kept for screen readers); "All categories" acts as the placeholder.
    $form['category']['#title'] = t('Category');
    $form['category']['#title_display'] = 'invisible';
    if (isset($form['category']['#options']['All'])) {
      $form['category']['#options']['All'] = t('All categories');
    }
    $form['category']['#attributes']['onchange'] = 'this.form.submit()';
    // Same look as the vehicles filters: white box, grey border, chevron.
    $form['category']['#attributes']['class'][] = '!w-full !h-11 !m-0 !pl-4 !pr-10 !py-0 appearance-none !bg-white !bg-none !text-body !text-sm !border !border-solid !border-gray-300 !rounded-sm !shadow-none cursor-pointer focus:!outline-none focus:!ring-0 focus:!border-primary';
    $form['category']['#wrapper_attributes']['class'][] = 'relative !m-0 w-full sm:w-64';
    $form['category']['#field_suffix'] = \Drupal\Core\Render\Markup::create('<svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-body" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>');
  }
  if (isset($form['actions'])) {
    // Applies on change; the button stays for keyboard / no-JS users.
    $form['actions']['#attributes']['class'][] = 'visually-hidden focus-within:not-sr-only';
  }
}

/**
 * Implements hook_preprocess_HOOK() for pager templates.
 *
 * Adds the total page count so the vehicles pager can show "1/2".
 */
function cruiserclassic_preprocess_pager(array &$variables) {
  $pager = \Drupal::service('pager.manager')->getPager($variables['pager']['#element'] ?? 0);
  $variables['total_pages'] = $pager ? $pager->getTotalPages() : 1;
}

/**
 * Implements hook_preprocess_HOOK() for breadcrumb.
 *
 * Drupal leaves the current page out of the trail; add it (unlinked) so the
 * breadcrumb reads HOME / SECTION / CURRENT PAGE.
 */
function cruiserclassic_preprocess_breadcrumb(array &$variables) {
  $variables['#cache']['contexts'][] = 'url.path';
  $route = \Drupal::routeMatch()->getRouteObject();
  if (!$route || \Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }
  $title = \Drupal::service('title_resolver')->getTitle(\Drupal::request(), $route);
  if (is_array($title)) {
    $title = \Drupal::service('renderer')->renderInIsolation($title);
  }
  if ($title !== NULL && (string) $title !== '') {
    $variables['breadcrumb'][] = ['text' => $title];
  }
}

/**
 * Implements hook_form_alter().
 *
 * Contact webform ("Send us an inquiry" design):
 * - Mobile: one column.
 * - Tablet and up: name/email and phone/interest in 2 columns; vehicle
 *   specifications and message full width.
 * - Labels above, underline-only fields, dark green button with an arrow.
 */
function cruiserclassic_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (($form['#webform_id'] ?? NULL) !== 'contact') {
    return;
  }

  $form['#attributes']['class'][] = 'contact-form grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 md:gap-y-7 w-full';

  $input = '!w-full !h-12 !m-0 !px-0 !py-0 !bg-transparent !text-body !text-base !border-0 !border-b !border-solid !border-[#cfcfc8] !rounded-none !shadow-none placeholder:!text-[#9a9a95] focus:!outline-none focus:!ring-0 focus:!border-primary';
  $full = ['vehicle_specs', 'message'];

  foreach (['name', 'email', 'phone', 'interest', 'vehicle_specs', 'message'] as $key) {
    if (!isset($form['elements'][$key])) {
      continue;
    }
    $element = &$form['elements'][$key];
    $element['#wrapper_attributes']['class'][] = '!m-0 w-full min-w-0' . (in_array($key, $full, TRUE) ? ' md:col-span-2' : '');
    $element['#label_attributes']['class'][] = '!block !mb-2 !text-body !text-sm md:!text-base !font-normal';
    $classes = $input;
    if ($key === 'message') {
      $classes = str_replace(['!h-12', '!py-0'], ['!h-auto !min-h-28 resize-y', '!py-3'], $input);
    }
    if ($key === 'interest') {
      $classes .= ' appearance-none cursor-pointer';
    }
    $element['#attributes']['class'][] = $classes;
    unset($element);
  }

  if (isset($form['elements']['actions'])) {
    $form['elements']['actions']['#attributes']['class'][] = '!m-0 md:col-span-2 flex pt-2';
    $form['elements']['actions']['#submit__attributes']['class'][] = 'contact-form__submit !w-fit !h-auto !m-0 !py-4 !pl-8 !pr-14 !bg-[#12301b] !text-white !text-base !font-normal uppercase tracking-wide !border-0 !rounded-none !shadow-none hover:!bg-[#1d4a2b] cursor-pointer';
  }
}

/**
 * Returns image data {src, alt, width, height} from an image Media entity.
 */
function cruiserclassic_media_image($media, string $fallback_alt = ''): array {
  $item = ($media && $media->hasField('field_media_image')) ? $media->get('field_media_image')->first() : NULL;
  if (!$item || !$item->entity) {
    return [];
  }
  return [
    'src' => \Drupal::service('file_url_generator')->generateString($item->entity->getFileUri()),
    'alt' => $item->alt ?: $fallback_alt,
    'width' => (int) $item->width,
    'height' => (int) $item->height,
  ];
}

/**
 * URL of the gallery filtered to a category, e.g. /gallery?category=245.
 */
function cruiserclassic_gallery_category_url($term): string {
  return \Drupal\Core\Url::fromUserInput('/gallery', ['query' => ['category' => $term->id()]])->toString();
}

/**
 * The gallery categories, ordered by weight.
 *
 * @return \Drupal\taxonomy\TermInterface[]
 */
function cruiserclassic_gallery_categories(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $storage->getQuery()->accessCheck(TRUE)->condition('vid', 'gallery_category')->condition('status', 1)->sort('weight')->sort('name')->execute();
  return $storage->loadMultiple($ids);
}

/**
 * Cover image of a category: its own cover, else its latest project's cover.
 */
function cruiserclassic_gallery_category_image($term): array {
  $image = cruiserclassic_media_image($term->get('field_cover_image')->entity, $term->label());
  if ($image) {
    return $image;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ([TRUE, FALSE] as $same_category) {
    $query = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'gallery')->condition('status', 1)->sort('created', 'DESC')->range(0, 1);
    if ($same_category) {
      $query->condition('field_gallery_category', $term->id());
    }
    $ids = $query->execute();
    $node = $ids ? $storage->load(reset($ids)) : NULL;
    if ($node && ($image = cruiserclassic_media_image($node->get('field_image')->entity, $node->label()))) {
      return $image;
    }
  }
  return [];
}

/**
 * Card data for one gallery project (node).
 */
function cruiserclassic_gallery_card($node, string $variant = 'below'): array {
  $category = $node->get('field_gallery_category')->entity;
  $image = cruiserclassic_media_image($node->get('field_image')->entity, $node->label());
  return array_filter([
    'image' => $image ?: NULL,
    'category' => $category ? $category->label() : '',
    'title' => $node->label(),
    'url' => $node->toUrl()->toString(),
    'new_tab' => FALSE,
    'variant' => $variant,
  ], fn($value) => $value !== NULL);
}

/**
 * Implements hook_preprocess_HOOK() for the gallery view rows.
 *
 * Builds `cards` for the Gallery Card component; each card opens the
 * project's detail page.
 */
function cruiserclassic_preprocess_views_view_unformatted__gallery(array &$variables) {
  $variables['cards'] = [];
  $home = $variables['view']->current_display === 'block_home';
  foreach (array_values($variables['view']->result) as $index => $row) {
    if (empty($row->_entity)) {
      continue;
    }
    $card = cruiserclassic_gallery_card($row->_entity, $index < 2 ? 'overlay' : 'below');
    // Homepage: one card per category, opening /gallery with it selected.
    $category = $home ? $row->_entity->get('field_gallery_category')->entity : NULL;
    if ($category) {
      $card['url'] = cruiserclassic_gallery_category_url($category);
    }
    $variables['cards'][] = $card;
  }
}

/**
 * Implements hook_preprocess_HOOK() for the gallery categories view rows.
 *
 * Homepage: one tile per category (2 large, then 3), each opening
 * /gallery/{category}.
 */
function cruiserclassic_preprocess_views_view_unformatted__gallery_categories(array &$variables) {
  $variables['cards'] = [];
  foreach (array_values($variables['view']->result) as $index => $row) {
    $term = $row->_entity ?? NULL;
    if (!$term) {
      continue;
    }
    $variables['cards'][] = [
      'image' => cruiserclassic_gallery_category_image($term),
      'category' => $term->label(),
      'title' => $term->get('field_short_title')->value ?: $term->label(),
      'url' => cruiserclassic_gallery_category_url($term),
      'new_tab' => FALSE,
      'variant' => $index < 2 ? 'overlay' : 'below',
    ];
  }
  $variables['#cache']['tags'][] = 'node_list:gallery';
}

/**
 * Implements hook_preprocess_HOOK() for gallery project nodes.
 *
 * Detail page: photos, specifications, contact links and 3 more projects
 * from the same category.
 */
function cruiserclassic_preprocess_node__gallery(array &$variables) {
  if ($variables['view_mode'] !== 'full') {
    return;
  }
  $node = $variables['node'];
  $category = $node->get('field_gallery_category')->entity;
  $cover = cruiserclassic_media_image($node->get('field_image')->entity, $node->label());

  $photos = $cover ? [$cover] : [];
  foreach ($node->get('field_gallery_photos')->referencedEntities() as $media) {
    if ($image = cruiserclassic_media_image($media, $node->label())) {
      $photos[] = $image;
    }
  }

  $specs = [];
  foreach ($node->get('field_gallery_specs') as $item) {
    $parts = array_map('trim', explode('|', (string) $item->value, 2));
    if ($parts[0] !== '') {
      $specs[] = ['label' => count($parts) > 1 ? $parts[0] : '', 'value' => end($parts)];
    }
  }

  $contact = fn(array $query) => \Drupal\Core\Url::fromUserInput('/contact-us', ['query' => $query])->toString();
  $more = [];
  if ($category) {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $ids = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'gallery')->condition('status', 1)
      ->condition('field_gallery_category', $category->id())->condition('nid', $node->id(), '<>')
      ->sort('created', 'DESC')->range(0, 3)->execute();
    foreach ($storage->loadMultiple($ids) as $other) {
      $more[] = cruiserclassic_gallery_card($other);
    }
  }

  $variables['gallery'] = [
    'cover' => $cover,
    'photos' => $photos,
    'category' => $category ? ['label' => $category->label(), 'url' => cruiserclassic_gallery_category_url($category)] : NULL,
    'summary' => $node->get('field_gallery_summary')->value,
    'specs' => $specs,
    'ask_url' => $contact(['vehicle_specs' => $node->label()]),
    'photos_url' => $contact(['vehicle_specs' => $node->label(), 'message' => t('Please send me more photos of @title.', ['@title' => $node->label()])]),
    'more' => $more,
    'breadcrumb' => array_filter([
      ['text' => t('Home'), 'url' => \Drupal\Core\Url::fromRoute('<front>')->toString()],
      ['text' => t('Gallery'), 'url' => \Drupal\Core\Url::fromUserInput('/gallery')->toString()],
      $category ? ['text' => $category->label(), 'url' => cruiserclassic_gallery_category_url($category)] : NULL,
      ['text' => $node->label()],
    ]),
  ];
  $variables['#cache']['tags'][] = 'node_list:gallery';
}

/**
 * Implements hook_preprocess_HOOK() for the services view rows.
 *
 * Builds `items` for the Service Item component, numbered in view order.
 */
function cruiserclassic_preprocess_views_view_unformatted__services(array &$variables) {
  $variables['items'] = [];
  foreach (array_values($variables['view']->result) as $index => $row) {
    $node = $row->_entity ?? NULL;
    if (!$node) {
      continue;
    }
    $link = $node->get('field_service_link')->first();
    $variables['items'][] = [
      'number' => str_pad((string) ($index + 1), 2, '0', STR_PAD_LEFT),
      'title' => $node->label(),
      'description' => (string) check_markup($node->get('field_service_description')->value ?? '', $node->get('field_service_description')->format ?? 'basic_html'),
      'link_text' => $link ? $link->title : '',
      'url' => $link ? $link->getUrl()->toString() : '',
      'first' => $index === 0,
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK() for the series tiles view rows.
 *
 * Each tile opens /vehicles with that series selected.
 */
function cruiserclassic_preprocess_views_view_unformatted__series_tiles(array &$variables) {
  $variables['tiles'] = [];
  foreach ($variables['view']->result as $row) {
    $term = $row->_entity ?? NULL;
    if ($term) {
      $variables['tiles'][] = [
        'label' => $term->label(),
        'url' => \Drupal\Core\Url::fromUserInput('/vehicles', ['query' => ['series' => $term->id()]])->toString(),
      ];
    }
  }
}
