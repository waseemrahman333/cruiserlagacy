{#
/**
 * Contact Us Section (Cruiserclassic)
 *
 * Left: heading + text slots, then the contact details list.
 * Right: white form card with a title and a line below it.
 *
 * Mobile: everything stacked. Tablet: stacked, the form card full width.
 * Desktop (1280px+): two columns.
 * details_position "between": tablet puts the details beside the text,
 * desktop pushes them to the bottom of the left column.
 *
 * contact_items: strings "Label | Value". Values that look like a phone
 * number or an email become tel: / mailto: links.
 */
#}
{% set heading_html %}{% block heading %}{% endblock %}{% endset %}
{% set text_html %}{% block text %}{% endblock %}{% endset %}
{% set form_html %}{% block form %}{% endblock %}{% endset %}

{% set bg_map = {
  'beige': 'bg-[#f8f5ef]',
  'white': 'bg-white',
  'surface-primary': 'bg-surface-primary',
  'surface-secondary': 'bg-surface-secondary',
  'surface-tertiary': 'bg-surface-tertiary',
  'none': '',
} %}
{% set bg_class = bg_map[backgroundcolor|default('beige')] ?? bg_map.beige %}

{% set has_heading = (show_heading ?? true) and heading_html|trim is not empty %}
{% set has_text    = (show_text ?? true) and text_html|trim is not empty %}
{% set items       = (show_contact_items ?? true) ? (contact_items|default([])) : [] %}
{% set between     = details_position|default('after') == 'between' %}

<section class="contact-section w-full {{ bg_class }}">
  <div class="container mx-auto w-full grid grid-cols-1 xl:grid-cols-2 gap-12 md:gap-14 xl:gap-[clamp(48px,6vw,112px)] py-[clamp(48px,7vw,96px)]">

    {# ---------- Left column ---------- #}
    <div class="contact-section__info min-w-0 flex flex-col gap-10 md:gap-12 {{ between ? 'md:flex-row md:justify-between xl:flex-col xl:justify-between' : '' }}">
      {% if has_heading or has_text %}
        <div class="flex flex-col gap-5 md:gap-6 {{ between ? 'md:max-w-[55%] xl:max-w-none' : '' }}">
          {% if has_heading %}
            <div class="contact-section__heading [&_*]:!m-0 [&_h1]:!font-heading [&_h2]:!font-heading [&_h3]:!font-heading [&_h1]:uppercase [&_h2]:uppercase [&_h3]:uppercase [&_h2]:!text-[clamp(1.75rem,1.2rem+1.8vw,2.5rem)] [&_h2]:!leading-tight">{{ heading_html }}</div>
          {% endif %}
          {% if has_text %}
            <div class="contact-section__text text-body/80 text-sm md:text-base leading-7 max-w-[560px] [&_p]:!m-0 [&_p+p]:!mt-3">{{ text_html }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if items is not empty %}
        <dl class="contact-section__details !m-0 flex flex-col gap-5 {{ between ? 'md:shrink-0' : '' }}">
          {% for item in items %}
            {% set parts = item|split('|', 2) %}
            {% set label = parts|length > 1 ? parts[0]|trim : '' %}
            {% set value = (parts|length > 1 ? parts[1] : parts[0])|trim %}
            {% if value %}
              <div>
                {% if label %}<dt class="!m-0 text-[#b9a26a] text-sm">{{ label }}</dt>{% endif %}
                <dd class="!m-0 mt-1 text-body text-base md:text-lg">
                  {% if value matches '/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/' %}
                    <a href="mailto:{{ value }}" class="!text-body !no-underline hover:!text-primary">{{ value }}</a>
                  {% elseif value matches '/^\\+?[0-9 ().-]{7,}$/' %}
                    <a href="tel:{{ value|replace({' ': '', '(': '', ')': '', '-': '', '.': ''}) }}" class="!text-body !no-underline hover:!text-primary">{{ value }}</a>
                  {% else %}
                    {{ value }}
                  {% endif %}
                </dd>
              </div>
            {% endif %}
          {% endfor %}
        </dl>
      {% endif %}
    </div>

    {# ---------- Form card ---------- #}
    {% if (show_form ?? true) and (form_title or form_html|trim is not empty) %}
      <div class="contact-section__form min-w-0 self-start w-full bg-white shadow-[0_20px_50px_rgba(0,0,0,0.08)] px-5 py-8 md:px-8 md:py-10">
        {% if form_title %}
          <h3 class=" pb-6 md:pb-8 mb-6 md:mb-8 border-b border-solid border-border !font-heading !text-body [font-variant:small-caps] !leading-tight !text-[clamp(1.25rem,1.1rem+0.5vw,1.5rem)]">{{ form_title }}</h3>
        {% endif %}
        {{ form_html }}
      </div>
    {% endif %}

  </div>
</section>
