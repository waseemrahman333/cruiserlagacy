{#
/**
 * Vehicle Slider Component
 *
 * Full-width image slider for the vehicle page. Title bottom-left and
 * prev/next arrows bottom-right sit on a dark gradient over the image.
 * Arrows are hidden when there is only one image.
 *
 * Props: images (array of {src, alt, width, height}), title, heading_level, autoplay
 */
#}
{% set items = images|default([])|filter(i => i.src is defined and i.src) %}
{% set tag = heading_level in ['h1', 'h2'] ? heading_level : 'h1' %}
{% set multiple = items|length > 1 %}

<section class="vehicle-slider container  w-full overflow-hidden"
         data-vehicle-slider
         data-autoplay="{{ autoplay ? 'true' : 'false' }}"
         aria-roledescription="carousel"
         aria-label="{{ title|default('Vehicle images'|t) }}">
<div class="relative">
        <div class="vehicle-slider__track">
          {% for image in items %}
            <div class="vehicle-slider__slide">
              <div class="aspect-[4/3] md:aspect-[16/9] xl:aspect-[12/5] w-full">
                <img src="{{ image.src }}" alt="{{ image.alt|default(title) }}"
                    {% if image.width %}width="{{ image.width }}"{% endif %}
                    {% if image.height %}height="{{ image.height }}"{% endif %}
                    {{ loop.first ? 'fetchpriority="high"' : 'loading="lazy"' }}
                    class="w-full h-full object-cover">
              </div>
            </div>
          {% endfor %}
        </div>

    {# Bottom gradient with title and arrows #}
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/75 via-black/30 to-transparent pt-24 md:pt-32">
      <div class="flex items-end justify-between gap-4 px-5 md:px-8 xl:px-10 pb-5 md:pb-8 xl:pb-10">
        {% if title %}
          <{{ tag }} class="vehicle-slider__title min-w-0 !m-0 !font-heading uppercase !text-white !leading-tight !text-[clamp(1.5rem,1rem+2vw,2.75rem)]">
            {{ title }}
          </{{ tag }}>
        {% endif %}

          {% if multiple %}
            <div class="pointer-events-auto flex shrink-0 gap-2 md:gap-3">
              {% set arrow = 'inline-flex items-center justify-center w-9 h-9 md:w-11 md:h-11 border border-white/80 text-white rounded-sm hover:bg-white hover:text-dark transition-colors disabled:opacity-40 disabled:pointer-events-none' %}
              <button type="button" class="{{ arrow }}" data-slider-prev aria-label="{{ 'Previous image'|t }}">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              </button>
              <button type="button" class="{{ arrow }}" data-slider-next aria-label="{{ 'Next image'|t }}">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>
          {% endif %}
        </div>
      </div>

    </div>
</section>
