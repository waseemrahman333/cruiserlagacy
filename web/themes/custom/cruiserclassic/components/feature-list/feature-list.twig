{#
/**
 * Feature List Component (Cruiserclassic)
 *
 * Heading + list of strings. Marker style decides the tag:
 * numbers → <ol>, everything else → <ul>.
 *
 * Props: heading, heading_color, item_color, heading_level, items[], list_style, marker_color,
 *        indent, columns, item_spacing, heading_spacing,
 *        heading_border_bottom, list_border_top, list_border_bottom, item_dividers, border_width, width
 */
#}

{# ============================================================
   1. MAPS
   ============================================================ #}
{# Native list markers (padding gives the marker room) #}
{% set native_map = {
  disc:    'list-disc',
  circle:  'list-[circle]',
  square:  'list-[square]',
  numbers: 'list-decimal',
} %}

{# Left indent: native markers need extra room for the marker itself #}
{% set indent_native_map = { none: 'pl-[1.15em]', sm: 'pl-8', md: 'pl-12', lg: 'pl-16' } %}
{% set indent_custom_map = { none: 'pl-0',       sm: 'pl-4', md: 'pl-8',  lg: 'pl-12' } %}

{% set columns_map = {
  '1': 'grid-cols-1',
  '2': 'grid-cols-1 md:grid-cols-2',
  '3': 'grid-cols-1 md:grid-cols-2 xl:grid-cols-3',
} %}

{% set item_spacing_map    = { sm: 'gap-y-2 md:gap-y-2.5', md: 'gap-y-3 md:gap-y-4', lg: 'gap-y-4 md:gap-y-6' } %}
{% set heading_spacing_map = { sm: ' !mt-3 md:!mt-4',  md: '!mt-5 md:!mt-6 xl:!mt-8', lg: '!mt-8 md:!mt-10 xl:!mt-12'} %}
{% set marker_color_map    = { body: 'marker:text-body', primary: 'marker:text-primary' } %}
{% set text_color_map = {
  body: '!text-body', heading: '!text-heading', primary: '!text-primary', secondary: '!text-secondary',
  tertiary: '!text-tertiary', dark: '!text-dark', white: '!text-white', gold: '!text-[#b9a26a]',
  'content-on-dark': '!text-content-on-dark',
} %}
{% set heading_color_class = text_color_map[heading_color] ?? text_color_map.body %}
{% set item_color_class = text_color_map[item_color] ?? text_color_map.body %}

{% set width_map = {
  fit:  'w-fit max-w-full',
  '25': 'w-full md:w-1/4',
  '33': 'w-full md:w-1/3',
  '50': 'w-full md:w-1/2',
  '66': 'w-full md:w-2/3',
  '75': 'w-full md:w-3/4',
  full: 'w-full',
} %}
{% set border_top_map      = { '1px': 'border-t',   '2px': 'border-t-2' } %}
{% set border_bottom_map   = { '1px': 'border-b',   '2px': 'border-b-2' } %}

{# ============================================================
   2. RESOLVED VALUES
   ============================================================ #}
{% set style    = list_style|default('disc') %}
{% set native   = native_map[style] is defined %}
{% set tag      = style == 'numbers' ? 'ol' : 'ul' %}
{% set h_tag    = heading_level in ['h2', 'h3', 'h4'] ? heading_level : 'h2' %}
{% set indent   = (native ? indent_native_map : indent_custom_map)[indent|default('sm')]|default('pl-4') %}
{% set color    = marker_color|default('body') %}
{% set list     = items|default([])|filter(i => i is not empty) %}
{% set bw       = border_width in ['1px', '2px'] ? border_width : '1px' %}
{% set dividers = item_dividers ?? false %}

{% set heading_classes = heading_border_bottom ? border_bottom_map[bw] ~ ' border-gray-300 pb-3 md:pb-4' : '' %}

{% set item_border = dividers ? border_bottom_map[bw] ~ ' border-gray-300 pb-2 md:pb-2.5' : '' %}

{% set list_classes = [
  'feature-list__items grid gap-x-8 !m-0',
  columns_map[columns|default('1')]|default('grid-cols-1'),
  item_spacing_map[item_spacing|default('sm')]|default(item_spacing_map.sm),
  heading ? heading_spacing_map[heading_spacing|default('md')] : '',
  indent,
  list_border_top ? border_top_map[bw] ~ ' border-gray-300 pt-3 md:pt-4' : '',
  list_border_bottom ? border_bottom_map[bw] ~ ' border-gray-300 pb-3 md:pb-4' : '',
  native ? native_map[style] ~ ' ' ~ marker_color_map[color] : 'list-none',
]|join(' ') %}

{% set icon_class = color == 'primary' ? 'text-primary' : 'text-body' %}

{# ============================================================
   3. MARKUP
   ============================================================ #}
<div class="feature-list {{ width_map[width|default('fit')]|default(width_map.fit) }}">
  {% if heading %}
    <{{ h_tag }} class="feature-list__heading !m-0 !font-heading uppercase {{ heading_color_class }} !leading-tight !text-[clamp(1.5rem,1.1rem+1.2vw,2.25rem)] {{ heading_classes }}">
      {{ heading }}
    </{{ h_tag }}>
  {% endif %}

  {% if list %}
    <{{ tag }} class="{{ list_classes }}">
      {% for item in list %}
        <li class="{{ item_color_class }} text-sm md:text-base leading-relaxed {{ native ? 'pl-1' : 'flex items-start gap-3' }} {{ item_border }}">
          {% if style == 'check' %}
            <svg class="w-4 h-4 mt-[0.3em] shrink-0 {{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {% elseif style == 'dash' %}
            <span class="shrink-0 {{ icon_class }}" aria-hidden="true">–</span>
          {% endif %}
          <span class="min-w-0">{{ item }}</span>
        </li>
      {% endfor %}
    </{{ tag }}>
  {% endif %}
</div>
