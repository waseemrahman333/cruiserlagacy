{#
/**
 * Hero Style One Component
 * 
 * Full-width hero section with background image, gradient overlay, title, description, and CTAs.
 * Designed for landing pages and feature sections.
 *
 * Available variables:
 * - title: (string) Hero heading text. Required.
 * - imageurl: (string) Background image URL. Use high-resolution images (1920px+ width).
 * - cta: (array|markup) Call-to-action buttons or links. Can be multiple.
 * - heading_level: (number) HTML heading level (1-6). Default: 1
 *
 * Accessibility:
 * - Uses semantic <section> with ARIA landmark
 * - Proper heading hierarchy
 * - Background image is decorative (aria-hidden via CSS)
 * - Text has sufficient contrast with overlay
 * - Focus indicators on interactive elements
 *
 * Theme Variables Used:
 * - text-body-bg: Text color on colored/image backgrounds
 * - Container spacing and responsive utilities
 *
 * Examples:
 * {% include 'tailpine:herostyleone' with {
 *   title: 'Welcome to Our Platform',
 *   description: 'Discover amazing features...',
 *   imageurl: 'https://cdn.pixabay.com/photo/...jpg',
 *   cta: cta_buttons,
 * } %}
 */
#}

{% set overlay_map = {
  '10': 'bg-black/10', '20': 'bg-black/20', '30': 'bg-black/30', '40': 'bg-black/40', '50': 'bg-black/50',
  '60': 'bg-black/60', '70': 'bg-black/70', '80': 'bg-black/80', '90': 'bg-black/90',
} %}
{% set overlay_class = (show_overlay ?? true) ? (overlay_map[overlay_opacity|default('40')] ?? '') : '' %}
{# {% set bg_image = imageurl|default('') %} #}

<div 
  class="w-full max-w-[1920px] mx-auto relative bg-cover bg-no-repeat bg-center"
  {% if image_url %}
  style="background-image: url('{{ image_url.src }}');"
  {% endif %}
  role="img"
  aria-label="Hero background"
>
  {% if overlay_class %}
  <div class="hero__overlay absolute inset-0 pointer-events-none {{ overlay_class }}" aria-hidden="true"></div>
  {% endif %}

  <!-- Hero Section -->
  <section 
    class="relative z-10 flex flex-col gap-4 px-5 pt-45 md:pt-65 xl:pt-160  pb-12.5 md:pb-25 md:px-12 md: xl:px-24"
    aria-label="Hero section"
  >
    <div class="content max-w-177 w-full text-body-bg">
      <h1
        class=" leading-tight !text-surface-100 md:leading-tight font-black uppercase text-shadow-lg"
      >
        {{ title }}
      </h1>

      {% if description %}
      <div class="hero__description mt-6 md:mt-8 max-w-[660px] !text-white/90 text-sm md:text-base leading-7 text-shadow-sm   ">
        {{ description }}
      </div>
      {% endif %}

      {# Note: keep tag names static (no <h{{ level }}>) — Canvas parses the
         HTML before a slot and skips the slot markers if it is invalid. #}
      {% if show_cta ?? true %}
      <div class="hero__cta w-full md:w-fit pt-10 flex flex-col md:flex-row gap-5 min-w-25">{{ cta }}</div>
      {% endif %}
    </div>
  </section>
</div>
