
{% set color_class = color_schema|default('secondary') %}
{% set button_Radius = buttonRadius|default('none') %}
{% set radiusMap = {
  'none': 'rounded-none',
  'sm':   'rounded-sm',
  'md':   'rounded-md',
  'lg':   'rounded-lg',
  'full': 'rounded-full'
} %}
{% set radius_class = radiusMap[button_Radius]|default('rounded-none') %}

{# ✅ Use ~ concatenation, NOT {{ }} inside strings #}
{% set base_classes = "group text-base leading-5 uppercase flex justify-center gap-2.5 items-center border transition-all duration-300 " ~ radius_class ~ " py-4 px-4 font-semibold" %}

{% set variant_classes = {
  'primary': 'hover:bg-transparent  border-transparent hover:border-tertiary text-tertiary font-secondary',
  'secondary': 'bg-transparent hover:bg-primary border-tertiary hover:border-transparent text-tertiary font-secondary'
} %}

{% set button_classes = base_classes ~ ' ' ~ variant_classes[variants] %}

<a href="{{ link }}" class = "{{button_classes}} " >
  {{ title }}
  {% if show_icon %}
  <svg
    class="group-hover:translate-x-1 transition-all duration-300"
    width="17" height="8" viewBox="0 0 17 8"
    fill="currentColor" xmlns="http://www.w3.org/2000/svg">
    <path d="M12.7393 8V4.8H0.0255641L0 3.192H12.7393V0L17 4L12.7393 8Z"/>
  </svg>
  {% endif %}
</a>