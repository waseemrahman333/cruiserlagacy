{#
/**
 * About Us Component (Cruiserclassic)
 *
 * Mobile / tablet (< 1280px):
 *   heading → intro → image (bleeds left; red starts 40% down the image) → red panel.
 * Desktop (1280px+):
 *   [heading | intro]
 *   [image   | red panel content]  — image bleeds to the left edge and its top
 *   40% sits above the red band, which spans the full width.
 *
 * The red band is placed with grid rows instead of absolute positioning, so the
 * image never overlaps any text: if the text is taller, the band grows.
 * --about-ratio (image height / width) sizes the part of the image above the band.
 *
 * Props: heading, description, image, show_panel_heading, show_panel_text, show_cta
 * Slots: panel_heading, panel_text, cta (each shown only when its switch is on)
 */
#}
{% set ratio = (image.width and image.height) ? (image.height / image.width) : 0.6 %}
{# {% set intro_html %}{% block intro %}{% endblock %}{% endset %} #}
{# {% set panel_html %}{% block panel_text %}{% endblock %}{% endset %} #}
{% set panel_heading_html %}{% block panel_heading %}{% endblock %}{% endset %}
{% set panel_text_html %}{% block panel_text %}{% endblock %}{% endset %}
{% set cta_html %}{% block cta %}{% endblock %}{% endset %}

<section class="about-us w-full overflow-hidden pt-[clamp(40px,6vw,120px)]" style="--about-ratio: {{ ratio }};">
  <div class="w-full ">

    {# ---------- Top: heading + intro ---------- #}
    <div class="about-us__top container ">
      <div class=" mx-auto w-full mb-23  grid gap-6 xl:gap-x-[clamp(40px,4vw,96px)]  xl:grid-cols-2 xl:items-end   pb-[clamp(24px,4vw,64px)] xl:pb-10 2xl:pb-0">
      {% if heading %}
        <h2 class="about-us__heading !m-0 !font-heading uppercase !text-body !leading-[1.15] !text-[clamp(1.75rem,1.2rem+2.2vw,2.75rem)] 2xl:col-start-1 2xl:row-start-1">
          {{ heading }}
        </h2>
      {% endif %}
      {% if description %}
        <div class="about-us__intro 2xl:col-start-2 2xl:row-start-2 text-body text-sm md:text-base leading-7 [&_p]:!m-0 [&_p+p]:!mt-3">
          {{ description}}
        </div>
      {% endif %}
      </div>
    </div>

    {# ---------- Bottom: image + red panel ---------- #}
    <div class="about-us__bottom bg-primary container grid grid-cols-1 xl:grid-cols-2 xl:grid-rows-[auto_1fr] xl:gap-x-[clamp(40px,4vw,96px)]">

      {# Desktop: sets row 1 = top 40% of the image (padding % is relative to width) #}
      <div class="hidden xl:block xl:col-start-1 xl:row-start-1" style="padding-top: calc(var(--about-ratio) * 40%);" aria-hidden="true"></div>

      {# Desktop: full-width red band behind row 2 #}
      <div class="hidden xl:block xl:col-span-2 xl:row-start-2 bg-primary " aria-hidden="true"></div>

      {# Image: full bleed on mobile/tablet with red starting 40% down; left bleed on desktop #}
      {% if image.src %}
        <div class="about-us__image relative z-10 xl:mr-0 xl:col-start-1 xl:row-span-2 xl:row-start-1 xl:self-start -ml-[var(--t-container-padding-inline)] -mt-23 
                    bg-[linear-gradient(to_bottom,transparent_40%,var(--color-primary)_40%)] xl:bg-none">
          <img src="{{ image.src }}" alt="{{ image.alt|default('') }}"
               {% if image.width %}width="{{ image.width }}"{% endif %}
               {% if image.height %}height="{{ image.height }}"{% endif %}
               loading="lazy"
               class="block w-full md:w-[72%] xl:w-full h-auto">
        </div>
      {% endif %}

      {# Red panel content #}
      <div class="about-us__panel relative z-10 xl:bg-transparent   xl:m-0 xl:p-0
                  xl:col-start-2 xl:row-start-2 xl:self-center
                  pt-[clamp(32px,5vw,56px)] pb-[clamp(40px,6vw,72px)] xl:py-[clamp(40px,4vw,80px)]">
        {% if (show_panel_heading ?? true) and panel_heading_html|trim is not empty %}
          <div class="[&_h1]:!text-white [&_h2]:!text-white [&_h3]:!text-white [&_h4]:!text-white [&_*]:!m-0">{{ panel_heading_html }}</div>
        {% endif %}
        {% if (show_panel_text ?? true) and panel_text_html|trim is not empty %}
          <div class="about-us__panel-text mt-4 md:mt-5 xl:mt-6 text-white text-sm md:text-base leading-7 [&_p]:!m-0 [&_p+p]:!mt-2">
            {{ panel_text_html }}
          </div>
        {% endif %}
        {% if (show_cta ?? true) and cta_html|trim is not empty %}
          <div class="about-us__cta mt-6 xl:mt-8">
            {{ cta_html }}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>
