        <img src="{{image.src}}" alt="{{image.alt}}" class="w-full h-full object-cover md:h-auto"> #}

                 {% if image.src %}
        <div class="about-us__image relative z-10 -ml-[var(--t-container-padding-inline)] -mr-[var(--t-container-padding-inline)] xl:mr-0 xl:col-start-1 xl:row-span-2 xl:row-start-1 xl:self-start
                    bg-[linear-gradient(to_bottom,transparent_40%,var(--color-primary)_40%)] xl:bg-none">
                    {# <img src="{{image.src}}" alt="{{image.alt}}" loading="lazy" class="block w-full md:w-[72%] xl:w-full h-auto"> #}
          <img src="{{ image.src }}" alt="{{ image.alt|default('') }}"
               {% if image.width %}width="{{ image.width }}"{% endif %}
               {% if image.height %}height="{{ image.height }}"{% endif %}
               loading="lazy"
               class="block w-full md:w-[72%] xl:w-full h-auto">
        </div>
      {% endif %}


       {# </div>  #}
