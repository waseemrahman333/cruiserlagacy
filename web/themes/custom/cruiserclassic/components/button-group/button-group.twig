{#
/**
 * Button Group Component (Cruiserclassic)
 *
 * Up to 3 button slots. Each screen size (mobile < 768px, tablet 768–1279px,
 * desktop 1280px+) has its own direction: stacked (column) or side by side (row).
 *
 * Props: button_count, direction_mobile, direction_tablet, direction_desktop,
 *        gap, alignment, full_width_mobile
 * Slots: button_1, button_2, button_3
 */
#}

{# ============================================================
   1. CLASS MAPS (full class names so Tailwind can find them)
   ============================================================ #}

{# Direction per breakpoint #}
{% set direction_map = {
  mobile:  { column: 'flex-col',     row: 'flex-row flex-wrap' },
  tablet:  { column: 'md:flex-col',  row: 'md:flex-row md:flex-wrap' },
  desktop: { column: 'xl:flex-col',  row: 'xl:flex-row xl:flex-wrap' },
} %}

{# Alignment: rows align with justify-*, columns align with items-* #}
{% set align_map = {
  mobile: {
    row:    { start: 'justify-start items-center',       center: 'justify-center items-center',       end: 'justify-end items-center' },
    column: { start: 'items-start justify-start',        center: 'items-center justify-start',        end: 'items-end justify-start' },
  },
  tablet: {
    row:    { start: 'md:justify-start md:items-center', center: 'md:justify-center md:items-center', end: 'md:justify-end md:items-center' },
    column: { start: 'md:items-start md:justify-start',  center: 'md:items-center md:justify-start',  end: 'md:items-end md:justify-start' },
  },
  desktop: {
    row:    { start: 'xl:justify-start xl:items-center', center: 'xl:justify-center xl:items-center', end: 'xl:justify-end xl:items-center' },
    column: { start: 'xl:items-start xl:justify-start',  center: 'xl:items-center xl:justify-start',  end: 'xl:items-end xl:justify-start' },
  },
} %}

{% set gap_map = {
  none: 'gap-0',
  sm:   'gap-2 md:gap-3',
  md:   'gap-3 md:gap-4',
  lg:   'gap-4 md:gap-6',
} %}

{# ============================================================
   2. RESOLVED VALUES
   ============================================================ #}
{% set count   = button_count|default('2')|number_format %}
{% set mobile  = direction_mobile in ['column', 'row'] ? direction_mobile : 'column' %}
{% set tablet  = direction_tablet in ['column', 'row'] ? direction_tablet : 'row' %}
{% set desktop = direction_desktop in ['column', 'row'] ? direction_desktop : 'row' %}
{% set align   = alignment in ['start', 'center', 'end'] ? alignment : 'start' %}
{% set stretch = (full_width_mobile ?? true) and mobile == 'column' %}

{% set group_classes = [
  'button-group flex w-full',
  direction_map.mobile[mobile],
  direction_map.tablet[tablet],
  direction_map.desktop[desktop],
  align_map.mobile[mobile][align],
  align_map.tablet[tablet][align],
  align_map.desktop[desktop][align],
  gap_map[gap|default('md')]|default(gap_map.md),
] %}

{# Each button cell: full width when stacked on mobile (optional), natural width from tablet up #}
{% set item_classes = stretch
  ? 'button-group__item w-full md:w-auto min-w-24 min-h-10 [&>*]:w-full md:[&>*]:w-auto'
  : 'button-group__item w-auto min-w-24 min-h-10' %}

{# ============================================================
   3. MARKUP
   ============================================================ #}
<div {{ attributes.addClass(group_classes) }} role="group">
  <div class="{{ item_classes }}">{% block button_1 %}{% endblock %}</div>
  {% if count >= 2 %}
    <div class="{{ item_classes }}">{% block button_2 %}{% endblock %}</div>
  {% endif %}
  {% if count >= 3 %}
    <div class="{{ item_classes }}">{% block button_3 %}{% endblock %}</div>
  {% endif %}
</div>
