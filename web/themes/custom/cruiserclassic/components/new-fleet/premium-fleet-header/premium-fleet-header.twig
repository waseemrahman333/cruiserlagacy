<section class="max-w-480 mx-auto w-full container py-[clamp(40px,calc(30px+5.714vw),120px)]">
  <div class="flex items-center gap-5 ">
    <span class="flex-1 h-px bg-border"></span>
    <h3 class="text-center w-1/2 md:w-fit text-balance tracking-wider uppercase">
      {{ title }}
    </h3>

    <span class="flex-1 h-px bg-border"></span>
  </div>

      {% if  main  %}
        <div class="pt-[clamp(30px,calc(23.75px+3.385vw),80px)]">
        {{ main }}
         </div>
      {% endif %}
      
</section>