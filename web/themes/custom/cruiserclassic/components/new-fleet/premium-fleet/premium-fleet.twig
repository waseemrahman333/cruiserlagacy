<div class="card-slide">
                <article class="relative  card-photo rounded-2xl overflow-hidden shadow-lg group bg-cover flex flex-col justify-end p-5 transition duration-300"
                    style="background-image: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0.1) 55%, transparent), url({{jeep_background}});">
                    <div class="relative z-10 flex items-center justify-between gap-3">
                        <h2 class="text-h2 font-bold text-secondary tracking-wide">{{jeep_title}}</h2>
                        <span class="shrink-0 bg-error text-secondary font-semibold text-xs px-3 py-1.5 rounded-full uppercase tracking-widest shadow">{{jeep_year}}</span>
                    </div>
                </article>
            </div>