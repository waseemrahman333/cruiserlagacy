{#
/**
 * Vehicle Card Component
 *
 * Listing card: image, title + status badge, then a two-column spec area
 * (engine / transmission with icons on the left, exterior / interior on the right).
 *
 * Props:
 * - image: { src, alt, width, height }
 * - title, url, badge_text, badge_variant
 * - engine, transmission, exterior, interior
 * - engine_icon, transmission_icon: optional SVG path/URL (falls back to inline icon)
 * - image_ratio, show_specs, show_colors, shadow
 *
 * Example:
 * {{ include('cruiserclassic:vehicle-card', {
 *   image: { src: image_url, alt: node.label },
 *   title: node.label,
 *   url: path('entity.node.canonical', {node: node.id}),
 *   badge_text: 'For Sale',
 *   engine: '2F 4.2L I6',
 *   transmission: 'Manual',
 *   exterior: 'Freeborn Red',
 *   interior: 'Cloth',
 * }) }}
 */
#}

{% set badge_variants = {
  'primary': 'bg-primary text-white',
  'dark': 'bg-dark text-white',
  'success': 'bg-success text-white',
  'outline': 'border border-primary text-primary bg-transparent',
} %}
{% set badge_classes = badge_variants[badge_variant]|default(badge_variants.primary) %}
{# A "Sold" badge is always muted grey, as in the design #}
{% if badge_text|lower|trim == 'sold' %}
  {% set badge_classes = 'bg-gray-400 text-white normal-case' %}
{% endif %}

{% set ratio_classes = {
  '4/3': 'aspect-[4/3]',
  '16/9': 'aspect-video',
  '1/1': 'aspect-square',
  '3/2': 'aspect-[3/2]',
} %}
{% set ratio = ratio_classes[image_ratio]|default('aspect-[4/3]') %}

{% set specs_on = show_specs ?? true %}
{% set colors_on = show_colors ?? true %}
{% set has_specs = specs_on and (engine or transmission) %}
{% set has_colors = colors_on and (exterior or interior) %}

<article class="vehicle-card @container group flex flex-col h-full bg-white rounded-md border border-gray-200 p-[clamp(16px,2vw,26px)] transition-shadow duration-300 {{ (shadow ?? true) ? 'hover:shadow-xl' }}">

  {# Image #}
  {% if image.src %}
    {% if url %}<a href="{{ url }}" class="block" tabindex="-1" aria-hidden="true">{% endif %}
      <div class="{{ ratio }} w-full overflow-hidden">
        <img src="{{ image.src }}" alt="{{ image.alt|default(title) }}"
             {% if image.width %}width="{{ image.width }}"{% endif %}
             {% if image.height %}height="{{ image.height }}"{% endif %}
             loading="lazy"
             class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
      </div>
    {% if url %}</a>{% endif %}
  {% endif %}

  {# Title + badge.
     The title is always clamped to 2 lines and reserves 2 lines of height,
     so cards in the same row line up whether the title is short or long. #}
  {% if title or badge_text %}
    <div class="flex items-start justify-between gap-3 mt-5">
      {% if title %}
        <h5 class="vehicle-card__title flex-1 min-w-0 line-clamp-2 min-h-[2lh] !m-0 !font-body  !font-medium !leading-snug !tracking-normal uppercase text-body group-hover:text-primary transition-colors" title="{{ title }}">
          {% if url %}<a href="{{ url }}" class="text-inherit no-underline">{{ title }}</a>{% else %}{{ title }}{% endif %}
        </h5>
      {% endif %}
      {% if badge_text %}
        <span class="shrink-0 whitespace-nowrap uppercase rounded-sm px-2 py-1 mt-0.5 text-xs font-medium {{ badge_classes }}">
          {{ badge_text }}
        </span>
      {% endif %}
    </div>
  {% endif %}

  {# Specs: two flex groups, text never wraps.
     Mobile/tablet: [engine ←→ transmission] on one row, then exterior / interior stacked.
     Large desktop (2xl, 1536px+):  [engine / transmission] on the left, [exterior / interior] on the right.
     Longer values push the right-hand item to the left; if space runs out they truncate. #}
  {% if has_specs or has_colors %}
    <div class="vehicle-card__specs mt-auto pt-4 flex flex-col gap-3 2xl:flex-row 2xl:items-start 2xl:justify-between 2xl:gap-4 text-body text-sm">

      {% if has_specs %}
        <dl class="vehicle-card__drive flex flex-row items-center justify-between gap-4 min-w-0 2xl:flex-col 2xl:items-start 2xl:justify-start 2xl:gap-3 !m-0">
          {% if engine %}
            <div class="flex gap-2 min-w-0">
              <dt class="shrink-0 flex items-center">
                {% if engine_icon %}<img src="{{ engine_icon }}" alt="" class="w-4 h-4" aria-hidden="true">{% else %}<svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 8h7l2 2h2v2h2v-2h1v6h-1v-2h-2v3h-2l-2 2H8l-2-2H4v-3H2v-2h2V10h3z"/><path d="M9 5h4M11 5v3"/>
              </svg>{% endif %}
                <span class="sr-only">{{ 'Engine'|t }}</span>
              </dt>
              <dd class="!m-0 font-medium truncate" title="{{ engine }}">{{ engine }}</dd>
            </div>
          {% endif %}
          {% if transmission %}
            <div class="flex items-center gap-2 shrink-0">
              <dt class="shrink-0 flex items-center">
                {% if transmission_icon %}<img src="{{ transmission_icon }}" alt="" class="w-4 h-4" aria-hidden="true">{% else %}<svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                <circle cx="5" cy="5" r="1.8"/><circle cx="12" cy="5" r="1.8"/><circle cx="19" cy="5" r="1.8"/>
                <circle cx="5" cy="19" r="1.8"/><circle cx="12" cy="19" r="1.8"/>
                <path d="M5 7v10M12 7v10M19 7v5H5"/><path d="M17 15h2.5a1.5 1.5 0 0 1 0 3H17v-3zm0 3v2m2.5-2 1 2"/>
              </svg>{% endif %}
                <span class="sr-only">{{ 'Transmission'|t }}</span>
              </dt>
              <dd class="!m-0 font-medium truncate">{{ transmission }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      {% if has_colors %}
        <dl class="vehicle-card__finish flex flex-col gap-3 min-w-0 2xl:max-w-[60%] !m-0">
          {% if exterior %}
            <div class="flex items-baseline gap-2 min-w-0">
              <dt class="shrink-0 !font-normal opacity-70">{{ 'Exterior'|t }}:</dt>
              <dd class="!m-0 font-medium whitespace-nowrap truncate" title="{{ exterior }}">{{ exterior }}</dd>
            </div>
          {% endif %}
          {% if interior %}
            <div class="flex items-baseline gap-2 min-w-0">
              <dt class="shrink-0 !font-normal opacity-70">{{ 'Interior'|t }}:</dt>
              <dd class="!m-0 font-medium whitespace-nowrap truncate" title="{{ interior }}">{{ interior }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

    </div>
  {% endif %}
</article>
