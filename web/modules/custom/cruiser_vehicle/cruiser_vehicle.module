<?php

/**
 * @file
 * Dependent vehicle taxonomy selects.
 *
 * Chain: Vehicle brand → Model type (field_select_brand)
 *   → Series (field_select_model_type) → Trim (field_select_series).
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Child vocabulary => field on its terms that points at the parent term.
 */
const CRUISER_VEHICLE_PARENT_FIELDS = [
  'model_type' => 'field_select_brand',
  'series' => 'field_select_model_type',
  'trim' => 'field_select_series',
];

/**
 * Builds [vid => [child tid => [parent tids]]] for the chain.
 */
function cruiser_vehicle_parent_map(): array {
  $map = [];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (CRUISER_VEHICLE_PARENT_FIELDS as $vid => $field) {
    $map[$vid] = [];
    foreach ($storage->loadByProperties(['vid' => $vid]) as $term) {
      $parents = [];
      if ($term->hasField($field)) {
        foreach ($term->get($field) as $item) {
          $parents[] = (string) $item->target_id;
        }
      }
      $map[$vid][(string) $term->id()] = $parents;
    }
  }
  return $map;
}

/**
 * Attaches the cascade behavior for one set of select names.
 */
function cruiser_vehicle_attach_cascade(array &$form, array $names, string $id): void {
  $map = cruiser_vehicle_parent_map();
  $form['#attached']['library'][] = 'cruiser_vehicle/cascade';
  $form['#attached']['drupalSettings']['cruiserCascade'][$id] = [
    'levels' => [
      ['name' => $names[0], 'parents' => NULL],
      ['name' => $names[1], 'parents' => $map['model_type']],
      ['name' => $names[2], 'parents' => $map['series']],
      ['name' => $names[3], 'parents' => $map['trim']],
    ],
  ];
  $form['#cache']['tags'][] = 'taxonomy_term_list';
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function cruiser_vehicle_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if ($form_state->getFormObject()->getEntity()->bundle() !== 'vehicle') {
    return;
  }
  cruiser_vehicle_attach_cascade($form, ['field_vehicle_model', 'field_model_type', 'field_series', 'field_trim'], 'node');
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 */
function cruiser_vehicle_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if ($view && $view->id() === 'vehicles') {
    cruiser_vehicle_attach_cascade($form, ['brand', 'model_type', 'series', 'trim'], 'filters');
    // Title suggestions under the search field; picking one applies the filter.
    if (isset($form['search'])) {
      $form['search']['#autocomplete_route_name'] = 'cruiser_vehicle.title_autocomplete';
      $form['#attached']['library'][] = 'cruiser_vehicle/search';
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for taxonomy_term.
 *
 * Changing a relationship changes the map, so rendered forms must refresh.
 */
function cruiser_vehicle_taxonomy_term_presave($term) {
  if (isset(CRUISER_VEHICLE_PARENT_FIELDS[$term->bundle()])) {
    \Drupal\Core\Cache\Cache::invalidateTags(['taxonomy_term_list']);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node.
 *
 * Gallery projects get the URL /gallery/{title} when no alias is set.
 */
function cruiser_vehicle_node_presave($node) {
  if ($node->bundle() !== 'gallery' || !$node->hasField('path')) {
    return;
  }
  $path = $node->get('path')->first();
  if ($path && trim((string) $path->alias) !== '') {
    return;
  }
  $slug = trim(preg_replace('/[^a-z0-9]+/', '-', mb_strtolower($node->label())), '-');
  $alias = '/gallery/' . $slug;
  $own_path = $node->isNew() ? NULL : '/node/' . $node->id();
  $repository = \Drupal::service('path_alias.repository');
  $candidate = $alias;
  for ($i = 2; ($existing = $repository->lookupByAlias($candidate, $node->language()->getId())) && $existing['path'] !== $own_path; $i++) {
    $candidate = $alias . '-' . $i;
  }
  $node->set('path', ['alias' => $candidate]);
}

/**
 * Implements hook_views_post_execute().
 *
 * Homepage gallery block: one project per category (the latest in each),
 * in category order.
 */
function cruiser_vehicle_views_post_execute($view) {
  if ($view->id() !== 'gallery' || $view->current_display !== 'block_home') {
    return;
  }
  $picked = [];
  foreach ($view->result as $row) {
    $term = $row->_entity ? $row->_entity->get('field_gallery_category')->entity : NULL;
    if ($term && !isset($picked[$term->id()])) {
      $picked[$term->id()] = ['row' => $row, 'weight' => $term->getWeight()];
    }
  }
  uasort($picked, fn($a, $b) => $a['weight'] <=> $b['weight']);
  $view->result = [];
  foreach (array_values($picked) as $index => $item) {
    $item['row']->index = $index;
    $view->result[] = $item['row'];
  }
}

/**
 * Implements hook_system_breadcrumb_alter().
 *
 * Gallery projects: Home / Gallery / {Category} (the theme appends the title).
 */
function cruiser_vehicle_system_breadcrumb_alter(\Drupal\Core\Breadcrumb\Breadcrumb &$breadcrumb, \Drupal\Core\Routing\RouteMatchInterface $route_match, array $context) {
  $node = $route_match->getParameter('node');
  if ($route_match->getRouteName() !== 'entity.node.canonical' || !$node instanceof \Drupal\node\NodeInterface || $node->bundle() !== 'gallery') {
    return;
  }
  $links = [\Drupal\Core\Link::createFromRoute(t('Home'), '<front>'), \Drupal\Core\Link::fromTextAndUrl(t('Gallery'), \Drupal\Core\Url::fromUserInput('/gallery'))];
  if ($category = $node->get('field_gallery_category')->entity) {
    $links[] = \Drupal\Core\Link::fromTextAndUrl($category->label(), \Drupal\Core\Url::fromUserInput('/gallery', ['query' => ['category' => $category->id()]]));
  }
  $replacement = new \Drupal\Core\Breadcrumb\Breadcrumb();
  $replacement->setLinks($links);
  $replacement->addCacheableDependency($breadcrumb);
  $replacement->addCacheableDependency($node);
  $replacement->addCacheContexts(['route']);
  $breadcrumb = $replacement;
}

/**
 * Implements hook_views_pre_build().
 *
 * Gallery page: the DraggableViews order (Content → Gallery order) applies to
 * "All categories" only; with a category selected the order is newest first.
 */
function cruiser_vehicle_views_pre_build(\Drupal\views\ViewExecutable $view) {
  if ($view->id() !== 'gallery' || $view->current_display !== 'block_page') {
    return;
  }
  $category = $view->getExposedInput()['category'] ?? 'All';
  if ($category !== 'All' && $category !== '') {
    unset($view->sort['weight']);
  }
}
